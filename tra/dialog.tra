@23927 = ~~ [DURLY_06]
@23928 = ~Je vous parlerai, si vous voulez.~ [TSCMT01]
@23929 = ~Hé, salut la jeunesse !~ [TSCMT02]
@23930 = ~Vous n'avez pas l'air d'être du coin, hein ?~ [TSCMT03]
@23931 = ~Bienv'nue dans not' petit village.~ [TSCMT04]
@23932 = ~Faites vite, je n'ai pas le temps de lambiner.~ [TSCMT05]
@23933 = ~Vous êtes pas d'ici vous, ça se voit !~ [TSCMT06]
@23934 = ~Pourquoi v'nez-vous m'importuner ?~ [TSCFT06]
@23935 = ~Oh, une nouvelle tête en ville, hein ?~ [TSCFT01]
