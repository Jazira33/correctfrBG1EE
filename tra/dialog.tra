@24148 = ~fin du dialogue~
@24149 = ~VERROUILLÉ~ [AMB_D05C]
@24150 = ~Vous ne pouvez utiliser d'armes lorsque vous avez changé de forme.~
@24151 = ~Cet objet ne peut pas être abandonné.~
@24152 = ~Votre classe de personnage ne vous permet pas d'utiliser une seconde arme.~
@24153 = ~Vous ne pouvez pas placer d'arme à deux mains ici.~
@24154 = ~Vous ne pouvez pas lancer plusieurs sorts de contingence sur vous-même.~
@24155 = ~Les moines ne peuvent pas utiliser d'armes à deux mains.~
@24156 = ~Vos caractéristiques ne vous permettent pas d'utiliser cet objet.~
@24157 = ~Force insuffisante.~
@24158 = ~Intelligence insuffisante.~
@24159 = ~Constitution insuffisante.~
@24160 = ~Sagesse insuffisante.~
