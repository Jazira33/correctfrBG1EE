@19877 = ~~ [VOIC5R]
@19878 = ~Rechtez où vous êtes, pâle enfant !~
@19879 = ~~ [VOIC6R]
@19880 = ~~ [VOIC1S]
@19881 = ~~ [VOIC2S]
@19882 = ~~ [VOIC3S]
@19883 = ~~ [VOIC4S]
@19884 = ~~ [VOIC5S]
@19885 = ~~ [VOIC6S]
@19886 = ~Votre peau ! Elle est verdâtre, vivante et... grouillante ! Qu'est-ce qui vous a fait ça ?~
@19887 = ~~ [VOIC1T]
@19888 = ~~ [VOIC2T]
@19889 = ~~ [VOIC3T]
@19890 = ~~ [VOIC4T]
@19891 = ~~ [VOIC5T]
@19892 = ~~ [VOIC6T]
@19893 = ~~ [VOIC1U]
@19894 = ~Écartez-vous et laissez-moi passer, je n'ai pas peur de vous !~
@19895 = ~~ [VOIC2U]
@19896 = ~~ [VOIC3U]
@19897 = ~~ [VOIC4U]
@19898 = ~~ [VOIC5U]
@19899 = ~~ [VOIC6U]
@19900 = ~~ [VOIC1V]
