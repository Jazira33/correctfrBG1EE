@23892 = ~Vous êtes pas d'ici... Vous sentez pas pareil.~ [SOLIA_01]
@23893 = ~Ah ! Maman !~ [SOLIA_02]
@23894 = ~Vous ferez pas mal à papa ou à maman !~ [SOLIA_03]
@23895 = ~Vous êtes bête ! Vous êtes pas comme les autres.~ [SOLIA_04]
@23896 = ~~ [SOLIA_05]
