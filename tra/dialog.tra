@23902 = ~~ [TOLAN_05]
@23903 = ~~ [TOLAN_06]
@23904 = ~Il faut qu'je parte d'ici ! 'Faut qu'je parte !~ [DALTO_01]
@23905 = ~~ [DALTO_02]
@23906 = ~~
@23907 = ~Laissez-moi tranquille ! Je vous en prie, n'approchez pas !~ [DALTO_04]
@23908 = ~~ [DALTO_05]
@23909 = ~~ [DALTO_06]
@23910 = ~Je ne peux pas y faire grand-chose. Inutile d'essayer...~ [CLDEL_01]
@23911 = ~Je ne suis pas encore prête à mourir ! Allez-vous en !~ [CLDEL_02]
@23912 = ~Luttez, et votre mort sera rapide !~ [CLDEL_03]
@23913 = ~Cet endroit ne m'aura pas.~ [CLDEL_04]
@23914 = ~~ [CLDEL_05]
@23915 = ~~ [CLDEL_06]
@23916 = ~Vous êtes plutôt une nouveauté... J'ai jamais vu quelqu'un comme vous avant.~ [DELAI_01]
@23917 = ~~
