@30757 = ~Je m'en fiche, taisez-vous, j'incanterai tout de même mon sort !~ [NEDONT]
@30758 = ~~ [NEERAM]
@30759 = ~~ [NEDYING2]
@30760 = ~Ooh, je déteste quand ça fait ça !~ [NEHATE]
