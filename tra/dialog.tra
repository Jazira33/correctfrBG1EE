@24623 = ~-- Espace laissé vide intentionnellement --~
@24624 = ~-- Espace laissé vide intentionnellement --~
@24625 = ~-- Espace laissé vide intentionnellement --~
@24626 = ~-- Espace laissé vide intentionnellement --~
@24627 = ~-- Espace laissé vide intentionnellement --~
@24628 = ~Yoshimo est mort et ne peut donc pas être importé dans Baldur's Gate II : Le Trône de Bhaal.~
@24629 = ~Imoen ne peut être importée dans Baldur's Gate II : Le Trône de Bhaal tant que vous ne l'avez pas sauvée. Vous pourrez néanmoins disposer d'une « version mise à jour » d'Imoen depuis Baldur's Gate II : Le Trône de Bhaal.~
@24630 = ~Les nouveaux joueurs devraient commencer avec l'initiation.~
@24631 = ~Initiation~
