@14611 = ~Shar-Teel, vous êtes faite pour préparer la cuisine et faire des enfants, alors fermez-la !~ [ELDOT30]
@14612 = ~Eldoth, vous êtes un rustre dégénéré et impuissant, qui se laisse bercer par l'illusion d'une soi-disant supériorité masculine.~ [SHART29]
@14613 = ~Un mot de plus, Eldoth, et je vous arrache la langue !~ [SHART27]
@14614 = ~Arrêtez ces pleurnicheries de petite fille !~ [ELDOT31]
@14615 = ~Eldoth, pourquoi traitez-vous nos compagnons aussi mal ?~ [SKIEE27]
@14616 = ~Eldoth, pourquoi traitez-vous nos compagnons aussi mal ?~ [SKIEE27]
