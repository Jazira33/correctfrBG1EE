@65235 = ~*PRINCIPAL/SAUVEGARDER* Une partie précédemment sauvegardée sera perdue. Quel emplacement souhaitez-vous écraser ?~
@65236 = ~*Retour*~
@65237 = ~Sauvegarde rapide.~
@65238 = ~Sauvegarde automatique ToB.~
@65239 = ~Sauvegarde rapide ToB.~
@65240 = ~*PRINCIPAL/HISTOIRE* Ici, vous pouvez passer des étapes de l'histoire et vous rendre directement aux chapitres suivants. Choisissez où vous souhaitez aller.

ATTENTION : vous ne pouvez qu'avancer dans l'histoire et non reculer ! N'utilisez pas cette fonctionnalité en plein combat ou pendant les cinématiques ! Évitez de faire marche arrière !~
@65241 = ~(Chapitre 7) Prologue.~
@65242 = ~(Chapitre 8) Pont de la Voie Côtière.~
@65243 = ~(Chapitre 9) Pont de Boreskyr.~
@65244 = ~(Chapitre 10) Camp de siège allié.~
@65245 = ~(Chapitre 11) Bataille du château Paldragon.~
@65246 = ~(Chapitre 12) Avernus.~
@65247 = ~(Chapitre 13) Épilogue.~
@65248 = ~*PRINCIPAL/HISTOIRE/CH7* Le chapitre 7 comprend la partie du jeu entre le début du siège de Paldragon et le départ pour le pont de la Voie Côtière.~
@65249 = ~Se rendre à l'attaque des assassins au Palais Ducal.~
@65250 = ~Se rendre au départ de la Porte de Baldur.~
@65251 = ~*PRINCIPAL/HISTOIRE/CH8* Le chapitre 8 comprend la partie du jeu qui se déroule au pont de la Voie Côtière.~
@65252 = ~Se rendre à l'arrivée au pont de la Voie Côtière.~
@65253 = ~*PRINCIPAL/HISTOIRE/CH9* Le chapitre 9 comprend la partie du jeu qui se déroule près du Pont de Boreskyr.~
@65254 = ~Se rendre à l'arrivée à la forêt des Griffes de Troll.~
@65255 = ~*PRINCIPAL/HISTOIRE/CH10* Le chapitre 10 comprend la partie du jeu qui se déroule entre l'arrivée au camp de siège allié et la bataille du château Paldragon.~
@65256 = ~Se rendre à l'arrivée au camp de siège allié.~
@65257 = ~Se rendre à la bataille du camp.~
@65258 = ~*PRINCIPAL/HISTOIRE/CH11* Le chapitre 11 comprend la bataille du château Paldragon.~
@65259 = ~Se rendre juste avant l'arrivée à la bataille du siège de Paldragon.~
@65260 = ~*PRINCIPAL/HISTOIRE/CH12* Le chapitre 12 se déroule en Avernus.
REMARQUE : pour des raisons techniques que Yaro ne peut se donner la peine de résoudre, vous ne pouvez vous rendre que jusqu'à la fin du chapitre 11, juste avant la scène du portail.~
@65261 = ~Se rendre à la scène d'ouverture du portail.~
@65262 = ~*PRINCIPAL/HISTOIRE/CH13* Le chapitre 13 se déroule après le retour d'Avernus.~
@65263 = ~Se rendre à la scène du rêve.~
@65264 = ~Se rendre à l'emprisonnement au quartier général du Poing Enflammé.~
