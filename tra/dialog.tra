@10316 = ~modifier~
@10317 = ~Les autres joueurs vont devoir télécharger de nouveau le jeu depuis le serveur. Voulez-vous vraiment modifier les personnages ?~
@10318 = ~Garde noir~
@10319 = ~Garde noir~
