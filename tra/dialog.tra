@14577 = ~En général, tout le monde fait ses preuves, mais il y a quelque chose de... bizarre chez vous.~ [KHALD30]
@14578 = ~En général, tout le monde fait ses preuves, mais il y a quelque chose de... bizarre chez vous.~ [KHALD30]
@14579 = ~En général, tout le monde fait ses preuves, mais il y a quelque chose de... bizarre chez vous.~ [KHALD30]
@14580 = ~Je ne pensais pas qu'on puisse être méchant à ce point. Vous avez sûrement besoin d-d-d'aide.~ [KHALD31]
@14581 = ~Ne vous moquez pas de moi ! Mon but est bien plus grand que vous ne l'imaginez !~ [MONTR30]
@14582 = ~Aaaaaah ! Pourquoi faut-il que vous nous enquiquiniez avec les problèmes des autres ? Vous ne pouvez donc pas nous laisser nous occuper de nos prooooopres affaires ?~ [XZARR30]
