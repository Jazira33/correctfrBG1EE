@70648 = ~~ [bdneo04]
@70649 = ~~ [bdneo05]
@70650 = ~~ [bdneo06]
@70651 = ~~ [bdneo08]
@70652 = ~~ [bdneo09]
@70653 = ~~ [bdneo11]
@70654 = ~~ [bdneo12]
@70655 = ~Homme : détendu~
@70656 = ~Homme : impatient~
@70657 = ~Homme : fervent~
@70658 = ~Homme : roublard~
@70659 = ~Homme : agressif~
@70660 = ~Homme : lettré~
@70661 = ~Homme : brute~
@70662 = ~Homme : impérieux~
@70663 = ~Homme : jovial~
@70664 = ~Femme : assurée~
@70665 = ~Femme : agressive~
@70666 = ~Femme : roublarde~
@70667 = ~Femme : âgée~
@70668 = ~Femme : impérieuse~
@70669 = ~Femme : enthousiaste~
@70670 = ~Femme : dure à cuire~
@70671 = ~Femme : détendue~
@70672 = ~Femme : lettrée~
@70673 = ~Vous m'entendez, Écudor ?~
@70674 = ~Sortez. Maintenant ! C'est un ordre !~
@70675 = ~Par tous les diables... Quel dieu ai-je offensé pour mériter ça ?~
@70676 = ~~
@70677 = ~placeholder~
@70678 = ~Si je dois me battre, je le ferai !~
@70679 = ~Dites adieu à votre visage.~
@70680 = ~Mordez donc la poussière !~
@70681 = ~Sang et deuil !~
@70682 = ~Retournez à la pierre !~
@70683 = ~Un choix avisé. J'ai l'expérience pour faire un bon chef.~
@70684 = ~Mes vieux os me font mal. C'est l'heure de dormir.~
@70685 = ~Si c'est tout ce qu'on va faire, j'aurais mieux fait de rester chez moi.~
@70686 = ~Je ne survivrai que si cette blessure est soignée.~
@70687 = ~Bien, nous pouvons y aller.~
@70688 = ~Puis-je vous conseiller ?~
@70689 = ~La bataille nous appelle à nouveau.~
@70690 = ~Et maintenant ?~
@70691 = ~Je vous entends.~
@70692 = ~Parlez.~
@70693 = ~Je sais ce que je fais.~
@70694 = ~D'accord.~
@70695 = ~C'est d'accord.~
@70696 = ~Je m'en charge.~
@70697 = ~Encore.~
@70698 = ~Avec le poids des montagnes.~
@70699 = ~Facile.~
@70700 = ~Aah !~
@70701 = ~Je peux enfin... me reposer...~
@70702 = ~Certains de ces arbres sont vieux comme des montagnes.~
@70703 = ~Chaque bâtiment qui résiste plaît à Moradin, le Créateur.~
@70704 = ~J'ai visité bien des lieux sombres, comme celui-ci. Écoutez mon conseil, si vous voulez en sortir en vie.~
@70705 = ~La lueur vive du jour blesse mes yeux fatigués.~
@70706 = ~Il fait sombre comme dans une tombe naine, cette nuit.~
@70707 = ~Mon arme frappe vite et sans merci !~
@70708 = ~Décider qui vit et qui meurt... De mon temps, on appelait ça la vie de soldat.~
@70709 = ~Comme un marteau sur l'enclume !~
@70710 = ~C'était un simple avertissement.~
@70711 = ~Peuh ! Cette arme ne sert à rien. Je devrais en essayer une autre.~
@70712 = ~Ma force a des limites. Je ne peux plus rien porter.~
@70713 = ~J'ai pris ce dont j'avais besoin.~
@70714 = ~Ici, mieux vaut être discret.~
@70715 = ~Que les Enfers soient maudits, mon sort a échoué.~
@70716 = ~Le piège est posé.~
@70717 = ~Le chemin de la vie n'est pas toujours évident, mais je crois que nous sommes sur le bon.~
@70718 = ~Je vous suis au combat, mais pas aveuglément. Redressez la barre.~
@70719 = ~Je n'ai pas signé pour des massacres gratuits. Nous pouvons faire mieux.~
@70720 = ~J'ai tourné le dos à cette vie, il y a longtemps, et je lui tourne le dos à nouveau. Adieu.~
@70721 = ~Ce n'est pas un hasard si j'ai vécu longtemps : je sais quand il faut fuir !~
@70722 = ~Une mort noble reste une mort.~
@70723 = ~Mangez de l'acier, chien !~
@70724 = ~Il est temps de mourir !~
@70725 = ~Vous voilà bien partis !~
@70726 = ~Chaque combat est une fête !~
@70727 = ~Je ne crains rien !~
@70728 = ~Je serai un bon chef, vous verrez !~
@70729 = ~Nous ferions mieux de nous reposer maintenant, alors que nous le pouvons.~
@70730 = ~Un grand destin m'attend ! Mais si nous continuons à rester plantés là à ne rien faire, il pourrait se lasser.~
@70731 = ~Ahhh, ça fait vraiment mal. À l'aide !~
@70732 = ~Bien, nous pouvons y aller.~
@70733 = ~C'est l'heure ?~
@70734 = ~L'aventure nous attend !~
@70735 = ~Oui ?~
@70736 = ~De quoi avez-vous besoin ?~
@70737 = ~Ici !~
@70738 = ~Je peux m'en charger.~
@70739 = ~Tout de suite !~
@70740 = ~Le danger peut toujours être vaincu.~
@70741 = ~J'y vais.~
@70742 = ~Pas très intéressant.~
@70743 = ~Ça n'a pas l'air difficile.~
@70744 = ~J'en ai toujours rêvé.~
@70745 = ~Ouf !~
@70746 = ~Impossible... pas déjà...~
@70747 = ~Un beau paysage allège la lassitude du voyage.~
@70748 = ~N'importe laquelle de ces personnes pourrait nous donner une quête intéressante !~
@70749 = ~Ça, c'est mon genre d'endroit. On peut trouver des monstres et des trésors n'importe où.~
@70750 = ~Quel plaisir de voir le soleil !~
@70751 = ~Soyez sur vos gardes. Ces ténèbres peuvent dissimuler n'importe quoi.~
@70752 = ~Je sauverai toujours la situation !~
@70753 = ~Je tente de penser à un sobriquet qui me conviendra, quand je serai célèbre. J'hésite entre « l'incroyable » et « le légendaire ».~
@70754 = ~Un coup direct !~
@70755 = ~Bon sang ! Tu ne perds rien pour attendre !~
@70756 = ~C'est sans effet. J'ai besoin d'une autre arme.~
@70757 = ~Je ne peux pas porter tout ça. Je dois poser quelque chose.~
@70758 = ~J'ai absolument besoin de ça.~
@70759 = ~Ça a marché ! Personne ne peut me voir ! Génial !~
@70760 = ~Oh non ! J'ai perdu mon sort.~
@70761 = ~Et un piège, un ! Un pas de trop, et CRAC.~
@70762 = ~C'est comme dans les histoires !~
@70763 = ~Ce n'est pas comme je l'imaginais.~
@70764 = ~Ça ne va pas. Nous sommes des héros, pas des méchants.~
@70765 = ~Je devrais être en train d'accomplir de grandes choses, pas... ce que nous faisons. Je m'en vais. Je peux me faire un nom sans vous.~
@70766 = ~J'avais tort, je ne suis pas à la hauteur !~
@70767 = ~Les bardes chanteront votre sacrifice.~
@70768 = ~Abattez-les !~
@70769 = ~Attention !~
@70770 = ~De la pâture pour les corbeaux !~
@70771 = ~Vous auriez dû me laisser partir tant que vous le pouviez.~
@70772 = ~Je hais la violence !~
@70773 = ~Vous voulez vraiment que je commande ? Alors, on est vraiment dedans.~
@70774 = ~Je n'ai rien contre la marche jusqu'à l'épuisement, mais on pourrait peut-être se reposer un peu ?~
@70775 = ~J'adore cette partie de la vie d'aventure. Celle où on se tourne les pouces pendant des heures.~
@70776 = ~Je vous avais bien dit que c'était une mauvaise idée ! Des soins, s'il vous plaît !~
@70777 = ~Hein ?~
@70778 = ~J'ai des oreilles.~
@70779 = ~Vous voulez autre chose ?~
@70780 = ~Et maintenant ?~
@70781 = ~Ouais ?~
@70782 = ~Je vous écoute !~
@70783 = ~Bien.~
@70784 = ~Peu importe.~
@70785 = ~Sinon quoi ?~
@70786 = ~Ouais, d'accord, c'est bon.~
@70787 = ~J'espère que ça ne prendra pas longtemps.~
@70788 = ~Quand ferons-nous une pause ?~
@70789 = ~Fortune et gloire mon... hem, mon ami !~
@70790 = ~Hé !~
@70791 = ~Et voilà le travail ! Je meurs.~
@70792 = ~Oh ! Là ! Encore un arbre ! Stupéfiant.~
@70793 = ~Vu que nous sommes en ville, on pourrait peut-être profiter d'un lit correct ? J'en ai assez de dormir sur des cailloux.~
@70794 = ~Si on me cherche, je serai derrière, dans une cachette, jusqu'à ce qu'on sorte d'ici.~
@70795 = ~C'est un nouveau jour riche en futilités qui s'annonce.~
@70796 = ~Impossible d'y voir sans lumière, et si j'en fais, tout ce qui traîne par ici pourra ME voir.~
@70797 = ~J'imagine que je devrais remercier les dieux d'être encore en vie.~
@70798 = ~Je suis peut-être décédé. Ça expliquerait à quel point je m'ennuie. Je ne suis qu'un fantôme qui arpente encore et encore les mêmes chemins.~
@70799 = ~Qu'est ce que vous dites de ÇA ?~
@70800 = ~J'ai raté. C'est fâcheux.~
@70801 = ~Il est évident que ça ne sert à rien. Il me faut une autre arme.~
@70802 = ~Je ne peux pas porter tout ça !~
@70803 = ~Je vais prendre ça.~
@70804 = ~Hoo, personne ne me voit. Je vais peut-être vivre encore un peu.~
@70805 = ~J'ai perdu mon sort. Tant pis.~
@70806 = ~Ça devrait me donner un avantage. Piège posé.~
@70807 = ~Ça se passe remarquablement bien. C'est une véritable surprise.~
@70808 = ~Je ne m'attendais pas à des miracles, mais quand même, je n'imaginais pas que les choses allaient tourner AUSSI mal.~
@70809 = ~Écoutez-moi bien : nous sommes aux bornes de ma tolérance. Continuez comme ça, et je m'en vais.~
@70810 = ~Voilà, j'ai ma dose. Je n'aurais jamais dû vous rejoindre, pour commencer. Adieu.~
@70811 = ~Sauve qui peut ! Aaaah !~
@70812 = ~C'est le sort qui nous attend tous. Et bientôt, vu ma veine.~
@70813 = ~C'est la fin !~
@70814 = ~Grrrr !~
@70815 = ~Le Faiseur de guerre nous appelle !~
@70816 = ~Pour la gloire !~
@70817 = ~Pas de quartier !~
@70818 = ~J'accepte ce rôle, bien que ce soit un fardeau.~
@70819 = ~Impossible d'ignorer l'appel du sommeil plus longtemps. Il est temps de nous reposer.~
@70820 = ~Ça ne rime à rien, de rester plantés là.~
@70821 = ~Soignez-moi, ou je mourrai !~
@70822 = ~Je vous écoute.~
@70823 = ~Parlez.~
@70824 = ~Oui ?~
@70825 = ~De quoi avez-vous besoin ?~
@70826 = ~Encore vous.~
@70827 = ~Hein ?~
@70828 = ~C'est d'accord.~
@70829 = ~Je m'en charge.~
@70830 = ~Je veux bien.~
@70831 = ~Hum.~
@70832 = ~Si les dieux le veulent.~
@70833 = ~Ma force est vôtre.~
@70834 = ~Je ne faillirai pas.~
@70835 = ~Aah !~
@70836 = ~Cette bataille pourrait être la dernière.~
@70837 = ~Dans les étendues sauvages, la violence et la mort sont omniprésentes.~
@70838 = ~Les villes sont des cages déguisées en palais. Soyez prudents.~
@70839 = ~Le sang s'est infiltré dans la moindre fissure de ce lieu ténébreux.~
@70840 = ~Face à une telle luminosité, je préfère les ombres.~
@70841 = ~Les ténèbres révèlent parfois plus qu'elles ne cachent.~
@70842 = ~Qu'avez-vous vu ? Rien ? Bien. Je ne faisais rien, alors il n'y avait rien à voir. Cessez donc de me regarder ainsi.~
@70843 = ~Un nécrophage ? Pourquoi fallait-il que ce soit un nécrophage... ?~
@70844 = ~Un coup meurtrier du Faiseur de guerre !~
@70845 = ~Vous avez eu de la chance, cette fois.~
@70846 = ~J'ai besoin d'une autre arme, pour vaincre cet adversaire.~
@70847 = ~Mon sac est plein. Je ne peux plus rien porter.~
@70848 = ~Et voilà, c'est à moi.~
@70849 = ~Je disparais.~
@70850 = ~Mince ! Mon sort.~
@70851 = ~Ce piège attend mon ennemi, comme le cobra attend le marcheur inattentif.~
@70852 = ~Tout va bien pour le moment. Puisse cela durer.~
@70853 = ~Ce que vous faites me déplaît. N'épuisez pas ma patience.~
@70854 = ~Attention à vous. Vous me voulez comme ami, pas comme ennemi.~
@70855 = ~Je ne tolérerai plus vos errements. Je m'en vais !~
@70856 = ~C'est une cause perdue ! Retraite !~
@70857 = ~La bataille mène une autre âme dans l'après-vie.~
@70858 = ~En garde !~
@70859 = ~Je vais vous rompre les os !~
@70860 = ~Raaaah !~
@70861 = ~Je ne me dérobe jamais devant l'ennemi !~
@70862 = ~C'est l'heure du carnage !~
@70863 = ~C'est moi qui commande ! Sang et batailles pour tout le monde !~
@70864 = ~Le dernier type que j'ai tabassé est moins crevé que moi. Reposons-nous.~
@70865 = ~Je ne tiens pas en place. Si nous ne nous mettons pas bientôt en route, quelqu'un va en prendre une.~
@70866 = ~Euh... Guérisseur ! Vite !~
@70867 = ~Oui ?~
@70868 = ~Besoin de tuer quelqu'un ?~
@70869 = ~Allons-y.~
@70870 = ~Juste là.~
@70871 = ~Vous avez un combat à livrer ?~
@70872 = ~Oui ?~
@70873 = ~Super !~
@70874 = ~Ah ! Très bien.~
@70875 = ~Plus ça saigne, mieux c'est.~
@70876 = ~Moi d'abord !~
@70877 = ~Tout de suite !~
@70878 = ~Tant que je peux cogner sur quelque chose.~
@70879 = ~C'est bon.~
@70880 = ~Han !~
@70881 = ~On ne peut pas toujours gagner, mais j'aurai essayé...~
@70882 = ~J'aime être dehors. On peut voir l'ennemi arriver avant qu'il ne soit à portée de frappe.~
@70883 = ~Le premier qui me regarde de trop près, je l'étripe.~
@70884 = ~Gare à vos coups, par ici. On a vite fait de toucher un ami, quand on se bat dans espace confiné.~
@70885 = ~Poauh ! Le soleil est levé, je peux voir toutes les taches de sang sur mes affaires. Hé, en voilà une nouvelle ! Qui m'a saigné dessus ?~
@70886 = ~Le soleil se couche sur une nouvelle tombe. Peut-être deux. Allez, au moins une demi-douzaine, je dirais.~
@70887 = ~Je me bats, encore, toujours et sans cesse.~
@70888 = ~Belle journée. Pour un MASSACRE.~
@70889 = ~Attention, Je lui ai ouvert les veines !~
@70890 = ~Reviens là, toi !~
@70891 = ~Dès que j'aurai trouvé la bonne arme, je vous démolis la trogne. Juste le temps d'en changer...~
@70892 = ~J'ai déjà trop de choses dans mes sacs. Je ne peux pas porter ça en plus.~
@70893 = ~Ha ha ! C'est à moi, à présent.~
@70894 = ~Embuscade prête !~
@70895 = ~Bon sang ! J'ai perdu mon sort ! La magie n'est pas fiable.~
@70896 = ~Ce piège a soif de sang.~
@70897 = ~C'est toujours sympathique, de massacrer les faibles en bonne compagnie.~
@70898 = ~J'ai l'impression de ne pas avoir tué quelqu'un depuis des lustres. Je veux de l'action !~
@70899 = ~Assez philosophé ! Parcourons les étendues sauvages en quête d'aventure, ou je m'en vais.~
@70900 = ~Assez ! Je m'en vais. Mais, réjouissez-vous, je vous laisse en vie. La plupart y laissent au moins une articulation, s'ils sont chanceux.~
@70901 = ~Aaahhh !~
@70902 = ~Nous ferons notre deuil quand le combat sera terminé.~
@70903 = ~Succombe à la nature !~
@70904 = ~Les esprits affluent à travers moi.~
@70905 = ~La vie devient la mort.~
@70906 = ~Tremblez devant ma puissance !~
@70907 = ~Le sol t'appelle à lui.~
@70908 = ~Les esprits me guident, et je vous guide à mon tour.~
@70909 = ~Tous les vivants doivent se reposer. À présent, c'est à moi de dormir.~
@70910 = ~Si nous restons ici plus longtemps, je vais prendre racine.~
@70911 = ~L'esprit est volontaire, mais le corps est rudement endommagé.~
@70912 = ~Parlez.~
@70913 = ~C'est à quel sujet ?~
@70914 = ~Oui ?~
@70915 = ~Les arbres murmurent.~
@70916 = ~Qui m'appelle ?~
@70917 = ~La roue tourne.~
@70918 = ~Je vous écoute.~
@70919 = ~C'est comme si c'était fait.~
@70920 = ~Comme vous dites.~
@70921 = ~C'est bien parti.~
@70922 = ~Les esprits sont d'accord.~
@70923 = ~Les éléments me guident.~
@70924 = ~Tel l'oiseau, je vole.~
@70925 = ~Aah !~
@70926 = ~Je retourne à la roue...~
@70927 = ~Le monde entier peut se trouver dans un gravier.~
@70928 = ~Les villes ne sont que des cimetières débordants de goules qui ne savent pas encore qu'elles sont mortes-vivantes.~
@70929 = ~Les vers fouisseurs et les scarabées nicheurs logent dans ces endroits sombres.~
@70930 = ~La lumière dorée réchauffe la terre et invite les plantes à sortir.~
@70931 = ~Les larmes de Séluné étincellent, cette nuit.~
@70932 = ~Sans la nature, aucun de nous ne serait en vie. Pensez-y.~
@70933 = ~Chaque feuille crie lorsqu'elle meurt, mais vous ne pouvez pas l'entendre.~
@70934 = ~Même le chêne le plus puissant peut tomber !~
@70935 = ~La fois suivante, je ne raterai pas.~
@70936 = ~Cet ennemi résiste à mes attaques. Permission d'utiliser une arme différente ?~
@70937 = ~De tels excès ne servent à rien. Mon sac est plein.~
@70938 = ~La nature n'admet pour seule loi que la survie du plus fort. Je prends ce dont j'ai besoin, en respectant cette loi.~
@70939 = ~Des esprits de ténèbres me protègent.~
@70940 = ~Hélas, mon sort a échappé à mon contrôle.~
@70941 = ~J'ai posé un piège astucieux.~
@70942 = ~Tout est en harmonie. Mon âme est en paix.~
@70943 = ~Je désapprouve un tel comportement. Il est opposé à la voie de la nature.~
@70944 = ~Je sens les esprits de cette contrée s'éloigner de moi. Nous devons nous réaligner avec eux, sinon, je devrai partir.~
@70945 = ~Je vais là où les esprits me mènent, et ils me mènent loin de vous. Peut-être qu'un jour, nos chemins se croiseront à nouveau.~
@70946 = ~Esprits du vent, donnez-moi la force de m'envoler !~
@70947 = ~Puissent les esprits de la terre vous accueillir.~
@70948 = ~Subissez ma colère ! Ce n'est qu'un avant-goût !~
@70949 = ~En BOUILLIE !~
@70950 = ~Je vais vous briser !~
@70951 = ~Vous êtes déjà vaincus !~
@70952 = ~Vous n'avez aucune chance, face à ma puissance.~
@70953 = ~Mes tactiques nous mèneront à la victoire, tout comme mes poings !~
@70954 = ~Mes forces baissent. Je dois me reposer, vite.~
@70955 = ~Mon esprit reste affûté, même quand mon corps est immobile. Quoi qu'il en soit, nous devrions avancer.~
@70956 = ~Soignez-moi ! Que je puisse reprendre le combat !~
@70957 = ~Paré au combat.~
@70958 = ~Qui s'oppose à nous ?~
@70959 = ~Je suis là.~
@70960 = ~Quoi ?~
@70961 = ~Hum ?~
@70962 = ~Je peux cogner sur quelque chose ?~
@70963 = ~J'ai un plan.~
@70964 = ~Avec la force de la terre.~
@70965 = ~Immédiatement.~
@70966 = ~Les poings d'abord.~
@70967 = ~C'est fait.~
@70968 = ~Facile.~
@70969 = ~Oui !~
@70970 = ~Argh !~
@70971 = ~C'était... ma destinée...~
@70972 = ~Quand vous saurez comment frapper à travers du balsa, vous saurez comment frapper à travers presque n'importe quel arbre.~
@70973 = ~La méditation me permet de retrouver mon calme, même dans les rues bondées.~
@70974 = ~Le mal est lové au cœur dans le cœur noir de cet endroit.~
@70975 = ~Mon ombre me suit partout où je vais, sauf quand c'est elle qui me guide.~
@70976 = ~La nuit est la mort du monde, mais ce n'est que temporaire.~
@70977 = ~Frappe le vent !~
@70978 = ~Il faut de la réflexion et du travail pour avoir l'air aussi impressionnant.~
@70979 = ~En plein dans les reins !~
@70980 = ~Haha ! Vous avez bougé.~
@70981 = ~Impossible de blesser celui-ci. Je dois changer de tactique.~
@70982 = ~Je ne pourrai plus rien faire rentrer dans ce sac. Je dois laisser un ou plusieurs objets.~
@70983 = ~Cela pourrait être utile.~
@70984 = ~Les ténèbres me font un manteau. Ni mon pas, ni mon souffle ne me trahiront.~
@70985 = ~Mes doigts ont raté ce sort !~
@70986 = ~Un piège pour attraper les imprudents.~
@70987 = ~Nous avons trouvé l'équilibre entre paix et violence.~
@70988 = ~Ça ne va pas.~
@70989 = ~Vous feriez mieux de corriger le tir, ou vous vous retrouverez sans qui que ce soit pour servir de chef. Sûrement pas moi, en tout cas.~
@70990 = ~J'en ai assez. Si je vous revois un jour, je vous accueillerai avec une droite. Gardez vos distances.~
@70991 = ~Hou hou hou hou !~
@70992 = ~Ils sont faibles, mais pas moi.~
@70993 = ~Une mort silencieuse.~
@70994 = ~Surprise !~
@70995 = ~Hé hé hé !~
@70996 = ~Je vous accorderai une mort rapide.~
@70997 = ~La mort vient d'en haut !~
@70998 = ~C'est moi qui mène, à présent. Gardez la tête baissée et nous survivrons.~
@70999 = ~Trouvons un endroit à l'écart, je n'en peux plus.~
@71000 = ~Ne rien faire est plutôt sûr, mais que c'est ennuyeux ! Il me faut de l'action.~
@71001 = ~Je perds mon sang. Haar. Guérisseur !~
@71002 = ~Derrière vous.~
@71003 = ~Ouais ?~
@71004 = ~Par ici.~
@71005 = ~Ne faites pas de bruit.~
@71006 = ~Quoi ?~
@71007 = ~Dites-le.~
@71008 = ~Vous ne me verrez même pas passer.~
@71009 = ~Je peux m'en charger.~
@71010 = ~Depuis les ombres.~
@71011 = ~C'est d'accord.~
@71012 = ~En silence.~
@71013 = ~Je m'en charge.~
@71014 = ~Bien.~
@71015 = ~Aah !~
@71016 = ~Nous aurions dû être plus prudents.~
@71017 = ~Ma cape se prend sans cesse dans les branches.~
@71018 = ~Je vais garder ma capuche sur la tête. Je ne veux pas qu'on me reconnaisse...~
@71019 = ~Des pièges, des serrures. Je me sens chez moi.~
@71020 = ~Si ça doit être le jour, est-ce qu'on peut au moins avoir des nuages ?~
@71021 = ~Il fait enfin nuit. Je me sens enfin dans mon élément.~
@71022 = ~Tout ce que je vois est à moi.~
@71023 = ~Parfois, je crois que je suis la seule personne au monde douée de bon sens.~
@71024 = ~Meurs en silence !~
@71025 = ~Vous n'avez rien vu.~
@71026 = ~Je ne peux rien lui faire. Il me faut changer d'armes.~
@71027 = ~Je suis trop chargé. Je ne peux rien porter de plus.~
@71028 = ~Encore un vol réussi.~
@71029 = ~Je ne suis plus là.~
@71030 = ~Bon sang ! Mon sort.~
@71031 = ~Piège posé et armé.~
@71032 = ~Si ça continue comme ça, je ferai rapidement fortune !~
@71033 = ~Je ne vois pas en quoi cela nous avantage.~
@71034 = ~Vous attirez trop d'attention. Je préfère agir avec plus de subtilité.~
@71035 = ~Je ne finirai pas en prison pour vous. Débrouillez-vous.~
@71036 = ~Ça ne vaut pas le coup de mourir pour ça.~
@71037 = ~Je préfère être à ma place plutôt qu'à la leur.~
@71038 = ~La destruction va pleuvoir sur vous !~
@71039 = ~J'en ai vu assez pour savoir que je peux vous battre.~
@71040 = ~Si nous devons combattre, vous perdrez.~
@71041 = ~Mes pouvoirs vous écraseront.~
@71042 = ~Affrontez ma magie.~
@71043 = ~Il est logique que les plus érudits dirigent.~
@71044 = ~Mes membres sont lourds, mes pensées plus encore. J'ai besoin de dormir.~
@71045 = ~Un esprit inactif s'étiole. Donnez-moi quelque chose à faire.~
@71046 = ~Je prédis ma mort, à défaut de soins !~
@71047 = ~C'est à quel sujet ?~
@71048 = ~Je connais vos secrets.~
@71049 = ~Est-ce urgent ?~
@71050 = ~D'autres demandes ?~
@71051 = ~J'ai un pressentiment.~
@71052 = ~Vous avez interrompu mes pensées.~
@71053 = ~Je vous l'accorde.~
@71054 = ~J'y réfléchis.~
@71055 = ~C'est tolérable.~
@71056 = ~Je vais y réfléchir.~
@71057 = ~Vrai.~
@71058 = ~Assurément.~
@71059 = ~Oui.~
@71060 = ~Aïe !~
@71061 = ~La mort... n'est pas toujours... la fin...~
@71062 = ~Certaines forêts abritent d'antiques secrets.~
@71063 = ~Là où la population se rassemble, elle érige des lieux de savoir. C'est une bonne chose.~
@71064 = ~Parfois, des énigmes et des mécanismes gardent les lieux anciens. Je peux surmonter de tels obstacles.~
@71065 = ~Je préfère lire à la lumière du soleil. Celle des chandelles fatigue les yeux.~
@71066 = ~Attention à ceux qui s'aventurent dans la nuit. Ils se méfieront de nous.~
@71067 = ~Les projectiles magiques permettent de prendre l'avantage sur pratiquement tout.~
@71068 = ~Orque, basilics, trolls, ankhegs... Tous sont vulnérables aux projectiles magiques.~
@71069 = ~Vilaine magie !~
@71070 = ~Mon antagoniste m'évite.~
@71071 = ~Cet adversaire résiste à mes attaques. Je dois essayer autre chose.~
@71072 = ~Si je suis trop chargé, je ne vous serai pas utile à grand-chose.~
@71073 = ~La main est plus leste que l'œil, et l'esprit plus encore.~
@71074 = ~J'ai obtenu un avantage tactique.~
@71075 = ~Ma maîtrise de la Toile défaille ! C'est inacceptable !~
@71076 = ~Un piège bien posé peut tromper les ennemis insouciants.~
@71077 = ~Je suis ravi de nos progrès.~
@71078 = ~Je le confesse : le chemin que nous empruntons me dérange.~
@71079 = ~Je ne prendrai pas part à des actes si méprisables. Que je n'aie pas à le redire.~
@71080 = ~Notre alliance est rompue. Je continuerai mon chemin seul, désormais.~
@71081 = ~Retraite ! Vite !~
@71082 = ~La magie d'un clerc pourrait ramener cette malheureuse âme à la vie.~
@71083 = ~La vie est un long fleuve tranquille. Très tranquille.~
@71084 = ~Si vous devez sauver le monde, mieux vaut l'aimer tel qu'il est.~
@71085 = ~Il faut que je me lie d'amitié avec un barde.~
@71086 = ~C'est une bonne chose que tous les ennemis que nous affrontons soient mauvais, sans aucun doute possible. Ça rend l'héroïsme bien plus facile.~
@71087 = ~HouuuuUUUuuuUUUUu.~
@71088 = ~Hé. Même la mort ne doit pas être aussi ennuyeuse.~
@71089 = ~Avez-vous vu mon marteau ?~
@71090 = ~Honnêtement ? J'ai toujours un peu considéré Dumok comme un âne.~
@71091 = ~Pas de sang, pas de gloire. Mais autant que ce soit le sang d'autrui.~
@71092 = ~Qu'est-ce qui est démoli, cassé et couvert de rouge ? Ta gueule !~
@71093 = ~Un battement d'aile de papillon peut causer la plus terrible des tempêtes, surtout si c'est un papillon-tempête lantanais.~
@71094 = ~Je pensais que le vent m'appelait, mais en fait, il s'adressait à la personne juste derrière moi. Quel quiproquo !~
@71095 = ~Mes paroles ont toujours l'air plus profondes, dans ma tête.~
@71096 = ~Défiez-moi et votre tête se retrouvera au sommet d'un corps différent. Beaucoup plus squelettique. Oui, je l'ai déjà fait !~
@71097 = ~Vous appelez ça un « coup en traître », j'appelle ça « se mettre en travers de mon chemin ».~
@71098 = ~Saluez tous le dieu cactus !~
@71099 = ~Franchement, il suffit de remplir un livre de sorts de projectiles magiques pour s'en sortir comme un chef.~
@71100 = ~Peut-être que ce Malcanter n'avait pas tort.~
@71101 = ~000000015-Début du prologue~
@71102 = ~000000016-Début du chapitre 8~
@71103 = ~000000017-Début du chapitre 9~
@71104 = ~000000018-Début du chapitre 10~
@71105 = ~000000019-Début du chapitre 11~
@71106 = ~000000020-Début du chapitre 12~
@71107 = ~000000021-Début du chapitre 13~
@71108 = ~Hé là !~
@71109 = ~Hé là, vous-même. Je cherche quelque chose qui sortirait de l'ordinaire.~
@71110 = ~Mourez, ordure !~
@71111 = ~Je me doutais que vous diriez ça.~
@71112 = ~Hé hé, je ne crois pas.~
@71113 = ~*c'est un tas de grosses pierres qui dissimule une cachette*~
@71114 = ~*le plafond de la grotte ne présente aucune faiblesse que vous pourriez exploiter, mais si l'on en croit le Pendule de pierre, placer le Tonneau de BOUM à cet endroit devrait avoir un effet dévastateur sur les défenses des croisés à Paldragon*~
@71115 = ~*placer le Tonneau de BOUM*~
@71116 = ~*garder le Tonneau de BOUM, du moins pour l'instant*~
@71117 = ~Le siège de Paldragon

Le Pendule de pierre m'a indiqué l'endroit où placer le Tonneau de BOUM.

Grâce au Pendule de pierre, je sais où placer le Tonneau de BOUM, afin qu'il fasse le plus de dégâts possible aux croisés rassemblés au château Paldragon. J'ai marqué l'emplacement sur ma carte, au cas où je devrais y revenir.~
@71118 = ~Serpent de pierre~
@71119 = ~Cave dissimulée~
@71120 = ~L'appel de l'entropiste

Neera a tous les ingrédients nécessaires à la création de sa potion.

J'ai donné à Neera tous les composants dont elle a besoin pour créer la potion qui devrait enfin la débarrasser d'Adoy.~
@71121 = ~Blugglugl, mon ami, J'ai entendu ton appel ! Rishthishaa ? Où es-tu ? Ici ? Non, non, je vois bien que non...~
@71122 = ~Les élémentaires de Strunk

J'ai occis un mage dans les grottes sous le château Paldragon.

En explorant les grottes de la rivière souterraine j'ai rencontré un magicien qui utilisait une puissante magie pour soumettre plusieurs élémentaires d'eau. Le tuer semble avoir libéré ses esclaves d'outre-monde.~
@71123 = ~Les armes de la Porte de Baldur, une nef puissante dominée par les cieux azur, et voguant sur des eaux bleu marine, ont été fièrement brodées sur cette bannière.~
@71124 = ~Aye, je suis libre, je sens la Fugue qui m'attire à elle, mais... Halatathlaer... Ma vieille amie. Je suis libre, mais pas elle. Trouvez son esprit, je vous en supplie. Libérez-la, elle aussi.~
@71125 = ~J'ai rencontré le fantôme de cet homme dans son château. Il est certain que vous deux vous retrouverez avant longtemps.~
@71126 = ~Le siège de Paldragon

Je dois parler avec le torsin de Lancie.

Les forces rassemblées contre la croisade ont pénétré dans la cour intérieure du château Paldragon. Je ferais mieux de parler de la progression de nos troupes avec un commandant de la coalition, avant d'entrer dans le château lui-même.~
@71127 = ~*le Pendule de pierre se balance d'avant en arrière, en quête de failles dans la roche... il donnera sans doute des indications plus précises lorsque vous vous rapprocherez du site*~
@71128 = ~Écoutez, vous devez m'aider. S'IL VOUS PLAÎT. Adoy est dans ma tête, et il me rend folle ! J'ai besoin d'ingrédients pour une potion, afin de me débarrasser de lui. J'ai de l'eau morte provenant d'en dessous du Pont de Boreskyr, à présent, il me faut une patte d'araignée à sept pattes.~
@71129 = ~Âtrefroid ? Non. Il y avait un géant dans l'autre grotte, à côté. Il n'a pas fait le poids.~
@71130 = ~Âtrefroid ? Non. Il y avait un géant dans la grotte, là-bas, mais les morts-vivants l'ont eu.~
@71131 = ~Qu'est-ce que vous dites ? Semahl est mort ? Imbécile, pauv' nunuche imberbe, le géant qu'z'avez tué était des nôt' !~
@71132 = ~Alors, Semahl est mort, hein ? Ach ! Il était pas ben malin, mais y méritait mieux.~
@71133 = ~D'accord, d'accord. Écoutez, Auchlin, calmez-vous. Semahl est mort, on y peut rien pour l'instant... <CHARNAME>, dites voir, vous auriez pas vu Gurn Âtrefroid ?~
@71134 = ~Glint Gardnersonson

Pritchard Gardnersonson, un parent de Glint, est au camp. Je devrais le chercher.

Apparemment, l'un des cousins de Glint Gardernsonson, Pritchard, est au camp de la coalition. Il vaudrait mieux, pour tout le monde, que je n'attende pas pour aller à sa rencontre.~
@71135 = ~Problème avec Pritchard

Je dois trouver le gnome Pritchard Gardnersonson.

Deux miliciens de Gué-de-la-Dague semblent avoir des difficultés avec leur officier supérieur, Pritchard Gardnersonson. Dans l'intérêt de tous ceux qui s'opposent à Caelar, il vaudrait mieux que je résolve cette situation, d'une façon ou d'une autre.~
@71136 = ~Glint Gardnersonson

Je devrais parler avec Glint à propos de son cousin, Pritchard Gardnersonson.

J'ai trouvé Pritchard Gardnersonson, mais que faire de lui ? Peut-être que son cousin, Glint, pourra m'aider à prendre une décision.~
@71137 = ~Problème avec Pritchard

Pritchard Gardnersonson ne fera plus obstacle à l'effort de guerre contre Caelar.

Tymora sourit aux forces qui assiègent le château Paldragon. Les problèmes que provoquait l'implication de Pritcheard Gardnersonson dans la coalition contre la Dame Étincelante aurait pu causer ont été tués dans l'œuf.~
@71138 = ~Glint Gardnersonson

Je devrais parler avec Glint à propos de son cousin, Pritchard Gardnersonson.

J'ai trouvé Pritchard Gardnersonson, mais que faire de lui ? Peut-être que son cousin, Glint, pourra m'aider à prendre une décision.~
@71139 = ~Problème avec Pritchard

La générale Main-de-pierre a décidé d'intervenir dans l'affaire Pritchard Gardnersonson.

J'ai expliqué à Pritchard Gardnersonson ce que ses subordonnés pensaient vraiment de lui. La générale Main-de-pierre de la milice de Gué-de-la-Dague a décidé de régler l'affaire en personne.~
@71140 = ~Problème avec Pritchard

Les soldats de Gué-de-la-Dague que Pritchard a mis en colère doivent être avertis de ce qui lui est arrivé.

Pritchard Gardnersonson ne sera plus une épine dans le pied de ceux qu'il commandait. Je dois dire aux miliciens qui m'ont parlé du problème que ce dernier est désormais résolu.~
@71141 = ~Glint Gardnersonson

Je dois ouvrir les yeux, au cas où je croiserais des membres de la famille Gardnersonson.

La famille de Glint est répartie dans toutes la Côte des Épées. Je dois faire attention, au cas où je rencontrerais certains de ses membres pendant mon voyage.~
@71142 = ~Problème avec Pritchard

J'ai informé Pritchard Gardnersonson que ses subordonnés grincheux ne seraient plus un souci.

Les miliciens de Gué-de-la-Dague qui étaient en conflit avec Pritchard Gardnersonson ont été ravis d'apprendre qu'ils n'auraient plus à le supporter. Ils étaient si contents qu'ils m'ont donné plusieurs potions, pour me remercier de les avoir débarrassés de leur problème.~
@71143 = ~Problème avec Pritchard~
@71144 = ~N'ayez aucune crainte, et Tempus sera avec vous !~
@71145 = ~Que fait donc une clerc de Tempus ici ?~
@71146 = ~Loué soit-il, en effet.~
@71147 = ~Pourquoi louer un dieu voué aux massacres ?~
@71148 = ~C'est un plaisir !~
@71149 = ~Je prépare les soldats pour la bataille à venir. Je savoure l'anticipation de la gloire promise. J'attends l'appel de mon seigneur.~
@71150 = ~Je soigne ceux qui ont acquis la gloire par une victoire juste. Tempus est très satisfait et offre son secours à ceux qui ont combattu honorablement.~
@71151 = ~Tempus ne désire pas de massacre. Quand le combat est nécessaire, ce qui est souvent le cas, Il exige simplement qu'il soit honorable, sans peur.~
@71152 = ~Et lorsque l'ennemi est vaincu, il convient de lui offrir quartier. Telle est la voie du juste.~
@71153 = ~Vous semblez avoir vécu bien des combats, pourtant, vous n'êtes pas soldat. Que désirez-vous ?~
@71154 = ~Quels services proposez-vous ?~
@71155 = ~Rien, en fait. Je m'en vais.~
@71156 = ~Que dire ? Sois sans peur. Ne fuis point le combat. Respecte les lois de la guerre. Tels sont Ses commandements.~
@71157 = ~Est-ce la raison pour laquelle vous l'adorez ?~
@71158 = ~« Ne fuis point le combat » ? Alors, il n'est pas question de battre en retraite ?~
@71159 = ~Quelles sont les lois de la guerre ?~
@71160 = ~Alors, vous ne craignez rien ?~
@71161 = ~Je n'ai plus de questions.~
@71162 = ~Nous découvrons tous notre vocation à notre manière, n'est-ce pas ?~
@71163 = ~La mienne m'est apparue rapidement. J'aimais le frisson du combat, la fougue qui s'emparait de moi lorsque j'affrontais l'ennemi.~
@71164 = ~Ma famille pensait que j'étais destinée à être soldat. Tempus m'a montré qu'il en allait autrement. Ce ne fut pas la première fois que je découvrais que mon chemin n'était pas celui que je croyais.~
@71165 = ~« Ne fuis point le combat ? » Alors, il n'est pas question de battre en retraite ?~
@71166 = ~Quelles sont les lois de la guerre ?~
@71167 = ~Alors, vous ne craignez rien ?~
@71168 = ~Je n'ai plus de questions.~
@71169 = ~Il ne s'agit pas de témérité. La retraite est une tactique, mais il n'est pas question d'éviter le combat lorsqu'il s'offre à vous. Il faut vaincre, et vaincre de façon décisive.~
@71170 = ~Alors, pourquoi VOUS suivez Tempus ?~
@71171 = ~Quelles sont les lois de la guerre ?~
@71172 = ~Alors, vous ne craignez rien ?~
@71173 = ~Je n'ai plus de questions.~
@71174 = ~Ne pas recourir à des ruses de lâche ou à des tactiques déshonorantes. Il faut respecter tous ses ennemis, car chacun peut être vaillant, même celui dont on doit prendre la vie.~
@71175 = ~Agissez ainsi et Tempus sera avec vous, car vous aurez défendu votre foyer et pourrez toujours vous présenter à autrui la tête haute.~
@71176 = ~Alors, pourquoi VOUS suivez Tempus ?~
@71177 = ~« Ne fuis point le combat ? » Alors, il n'est pas question de battre en retraite ?~
@71178 = ~Alors, vous ne craignez rien ?~
@71179 = ~Je n'ai plus de questions.~
@71180 = ~Que devrais-je craindre ? La guerre ?~
@71181 = ~La guerre est une force naturelle, une tempête engendrée par la seule existence de la civilisation. Je rirai parmi ses foudres et chevaucherai ses vents tant que je le pourrai.~
@71182 = ~Un jour, je périrai. Alors, je rejoindrai mon dieu avec joie, sachant que je L'ai bien servi. Rien n'est à redouter, dans une telle vie.~
@71183 = ~Alors, pourquoi VOUS suivez Tempus ?~
@71184 = ~« Ne fuis point le combat ? » Alors, il n'est pas question de battre en retraite ?~
@71185 = ~Alors, vous ne craignez rien ?~
@71186 = ~Je n'ai plus de questions.~
@71187 = ~Alors, j'imagine que vous allez prendre congé.~
@71188 = ~Je crois avoir trouvé votre amulette.~
@71189 = ~Quand j'ai rapporté votre amulette, vous avez parlé d'acceptation. Que vouliez-vous dire ?~
@71190 = ~Quels services proposez-vous ?~
@71191 = ~En effet. À plus tard.~
@71192 = ~Attendez ! J'ai... un service à vous demander.~
@71193 = ~Pendant notre marche jusqu'ici, nous avons rencontré des croisés à l'orée est de la forêt. Au cours du combat, j'ai perdu une amulette.~
@71194 = ~Nous avons dû battre en retraite, et je n'ai toujours pas pu y retourner. Si vous la trouvez, j'apprécierais que vous me la rameniez. Elle a beaucoup de valeur, à mes yeux.~
@71195 = ~Une amulette ? Comme celle-ci ?~
@71196 = ~Pourquoi n'allez-vous pas la chercher ?~
@71197 = ~Est-elle enchantée ?~
@71198 = ~J'ouvrirai les yeux. À quoi ressemble-t-elle ?~
@71199 = ~Quelle valeur, exactement ?~
@71200 = ~J'ai des choses plus importantes à faire.~
@71201 = ~Le Seigneur des Batailles exige que je reste avec les soldats, pour les guérir et les préparer. Je ne peux pas consacrer du temps à une tâche dont je serais seule bénéficiaire.~
@71202 = ~Serait-ce votre amulette ?~
@71203 = ~Est-elle enchantée ?~
@71204 = ~J'ouvrirai les yeux. À quoi ressemble-t-elle ?~
@71205 = ~Que vaudrait la récupération de cette amulette ?~
@71206 = ~J'ai des choses plus importantes à faire.~
@71207 = ~Magique ? Non, rien de tel. C'est un souvenir qui n'a de véritable valeur que pour moi.~
@71208 = ~Serait-ce votre amulette ?~
@71209 = ~Pourquoi n'allez-vous pas la chercher ?~
@71210 = ~J'ouvrirai les yeux. À quoi ressemble-t-elle ?~
@71211 = ~Que vaudrait la récupération de cette amulette ?~
@71212 = ~J'ai des choses plus importantes à faire.~
@71213 = ~Elle vaut la récompense que je serai en mesure de vous offrir, et mon amitié.~
@71214 = ~Serait-ce votre amulette ?~
@71215 = ~Pourquoi n'allez-vous pas la chercher ?~
@71216 = ~Est-elle enchantée ?~
@71217 = ~J'ouvrirai les yeux. À quoi ressemble-t-elle ?~
@71218 = ~Votre amitié est sans valeur.~
@71219 = ~Elle est en bois sculpté et porte le symbole de Tempus. C'est une pièce unique, ma mère l'a faite avant que je ne me consacre à la prêtrise.~
@71220 = ~J'imagine qu'elle est perdue pour toujours, mais nous verrons bien. Je garde espoir.~
@71221 = ~Très bien. Si c'est impossible, alors soit.~
@71222 = ~C'est elle ! Vous l'avez trouvée !~
@71223 = ~Je ne saurais vous dire à quel point elle est importante pour moi. C'est un symbole d'acceptation de la part de ma famille, quelque chose que je garderai pour toujours.~
@71224 = ~Leur acceptation ? De votre foi ?~
@71225 = ~Pour ma part, je vais chérir ma récompense.~
@71226 = ~C'est un plaisir de vous l'avoir retrouvée.~
@71227 = ~Il y a des initiales, au dos de l'amulette. L'une du nom qu'on m'a donné à la naissance, l'autre de celui que je porte actuellement. C'est ma mère qui les a gravées.~
@71228 = ~Voyez-vous, cette amulette commémore la première fois où mes parents m'ont appelé Mizhena, et ont accepté que j'étais cette personne. Je n'arrive pas à croire que j'ai été assez imprudente pour la perdre.~
@71229 = ~Vous avez changé de nom ?~
@71230 = ~Je n'ai pas envie d'en savoir plus.~
@71231 = ~En effet. Il s'est avéré que mon nom de naissance ne me convenait pas.~
@71232 = ~C'est quelque chose que les autres comprennent rarement, mais ceci... ceci m'a montré que c'était possible. Merci de l'avoir ramenée.~
@71233 = ~C'est un plaisir de vous avoir rendu service.~
@71234 = ~Tout ça n'a aucun sens, pour moi.~
@71235 = ~Vous aviez mentionné une récompense.~
@71236 = ~Attendez. Alors, vous êtes un homme ?~
@71237 = ~Je sais exactement ce que vous voulez dire. C'est pareil pour moi.~
@71238 = ~Prenez ceci en guise de remerciement. Que Tempus veille sur vous lors des combats à venir.~
@71239 = ~Je m'en doutais. Bienvenue, mon frère.~
@71240 = ~Je m'en doutais. Bienvenue, ma sœur.~
@71241 = ~Heureusement, cela importe peu. Voici votre récompense, comme promis. Encore merci.~
@71242 = ~Non, et c'est justement là où le bât blessait. Je n'en ai jamais été un, du moins pas en ce qui m'importait.~
@71243 = ~Mais... n'existe-t-il pas des sorts pour... vous transformer ?~
@71244 = ~Ça n'a aucun sens.~
@71245 = ~Bah, on trouve bien plus étrange dans ce monde, j'imagine.~
@71246 = ~Veuillez m'excuser si mes questions vous offensent.~
@71247 = ~Non pas que cela vous regarde, mais comment pourriez-vous savoir si j'y ai eu recours ou non ? C'est mon cheminement, à moi seule.~
@71248 = ~Ça n'a aucun sens.~
@71249 = ~Bah, on trouve bien plus étrange dans ce monde, j'imagine.~
@71250 = ~Veuillez m'excuser si mes questions vous offensent.~
@71251 = ~Onques ne parla-on avec autant de sagesse. Voici votre récompense, comme promis. Encore merci.~
@71252 = ~Peut-être, mais le service que vous m'avez rendu vaut bien le pardon de petites indiscrétions.~
@71253 = ~De la terre retournée et des traces de sang montrent qu'un combat s'est récemment produit ici. Une piste mène au nord du site, comme si un gros animal avait traîné quelques cadavres.~
@71254 = ~Ces traces semblent être celles d'un lion, mais aucun lion n'est aussi grand et on n'en trouve que rarement dans cette région. Nous devrions être prudents.~
@71255 = ~Je n'aime pas ce que révèlent ces traces. On dirait qu'elles proviennent d'un félin, mais plus grand que tout ce que je connais. Avançons.~
@71256 = ~De grosse traces de griffes, ça donne un gros chat. Danger.~
@71257 = ~Rebonjour ! Puis-je vous aider ?~
@71258 = ~Je crois avoir trouvé votre amulette.~
@71259 = ~Quand j'ai rapporté votre amulette, vous avez parlé d'acceptation. Que vouliez-vous dire ?~
@71260 = ~Quels services proposez-vous ?~
@71261 = ~C'est un plaisir de vous revoir en bonne santé. Puisse le Seigneur des Batailles veiller sur vous.~
@71262 = ~Quels services proposez-vous ?~
@71263 = ~Le plaisir est partagé.~
@71264 = ~S'il vous plaît, j'ai besoin de vous parler !~
@71265 = ~Pouvez-vous m'accorder un peu de votre temps ?~
@71266 = ~J'ai besoin de votre aide !~
@71267 = ~C'est un plaisir de vous revoir en bonne santé. J'hésite à vous le demander, mais...~
@71268 = ~Oui ? De quoi avez-vous besoin ?~
@71269 = ~Ce n'est pas pour moi, c'est pour mon père.~
@71270 = ~Avant de faire une brèche pour prendre la cour, j'ai appris qu'il faisait partie d'une avant-garde qui a été capturée. J'espérais le trouver, mais je ne trouve aucun signe de lui.~
@71271 = ~Pouvez-vous chercher mon père parmi les prisonniers que vous rencontrerez ?~
@71272 = ~Je ferai de mon mieux.~
@71273 = ~Vous êtes consciente de ce qui s'est probablement produit, Mizhena ?~
@71274 = ~C'est une guerre. Je ne vous promets rien.~
@71275 = ~Mizhena, je regrette, mais j'ai déjà trouvé votre père. Il est mort.~
@71276 = ~Je l'ai déjà trouvé. Il est vivant et libre.~
@71277 = ~Je l'ai déjà trouvé. Votre père est vivant et vous fait savoir qu'il est fier de vous. Il espère vous revoir bientôt.~
@71278 = ~C'est un tel soulagement. Puisse le Seigneur des Batailles vous bénir.~
@71279 = ~Je ne le suis que trop. Je veux simplement connaître la vérité, quelle qu'elle soit. Que Tempus guide vos pas.~
@71280 = ~Avez-vous découvert ce qui est arrivé à mon père ? Je suis rongée d'inquiétude.~
@71281 = ~Pas encore, Mizhena.~
@71282 = ~Ayez confiance. Je vais continuer à chercher.~
@71283 = ~Je crains qu'il ne soit mort, Mizhena.~
@71284 = ~Votre père est vivant, et désormais libre.~
@71285 = ~Votre père est vivant et vous fait savoir qu'il est fier de vous. Il espère vous revoir bientôt.~
@71286 = ~Je vais continuer à prier pour que le Seigneur des Batailles soit miséricordieux, alors. Merci.~
@71287 = ~Il est... mort. Ah.~
@71288 = ~Ce n'est pas un obstacle insurmontable pour le Seigneur des Batailles. Je dois partir immédiatement à la recherche de son corps et... et espérer que ma foi sera suffisante.~
@71289 = ~Merci pour tout. Puisse Tempus être toujours à vos côtés.~
@71290 = ~Il est vivant ? Vraiment ?~
@71291 = ~Sois remercié, Marteleur d'ennemis. Tu n'as pas de favoris, pourtant, je suis reconnaissante que Tu n'aies pas prélevé ma dîme en ce jour.~
@71292 = ~Je vous remercie aussi, de tout mon cœur. Prenez ceci, ainsi que la bénédiction du Seigneur des Batailles. Je n'oublierai jamais votre bonté.~
@71293 = ~Vous ne me mentiriez pas, n'est-ce pas ?~
@71294 = ~Non. Je vous ai transmis le message tel qu'il m'a été remis. Il veut échanger des récits de guerre autour de quelques chopes.~
@71295 = ~Alors, je ne sais que dire. Certaines batailles sont plus dures que d'autres. Vous le comprenez sûrement.~
@71296 = ~C'est vous qui avez sauvé la Porte de Baldur, n'est-ce pas ? Merci ! La croisade n'est pas tendre avec ses prisonniers, et nous n'aurions pas fait long feu.~
@71297 = ~Je n'ai fait que mon devoir.~
@71298 = ~Allez-y. La coalition assurera votre sécurité.~
@71299 = ~Ils avaient du butin. La guerre reste la guerre.~
@71300 = ~Vous êtes avec la coalition ? Dites-moi, savez-vous ce qu'il est advenu de la clerc de Tempus qui est avec eux ? Elle s'appelle Mizhena.~
@71301 = ~Vous êtes le père de Mizhena ?~
@71302 = ~Elle est morte pendant la bataille.~
@71303 = ~Je ne la connais pas du tout.~
@71304 = ~Elle est toujours avec la coalition, je l'ai rencontrée.~
@71305 = ~En effet. Comment me connaissez-vous ?~
@71306 = ~Mizhena m'a demandé de vous trouver.~
@71307 = ~C'est bien elle. Depuis la mort de sa mère, elle se fait sans cesse du souci pour moi. Comme si je n'avais pas mené cette vie avant.~
@71308 = ~Ça me réchauffe le cœur. Tout n'a pas toujours été rose, entre elle et moi, mais j'essaie.~
@71309 = ~Si vous voulez bien, dites-lui que je vais bien. Que je suis... fier de ce qu'elle est devenue, et que j'espère la voir bientôt. Nous échangerons nos récits de guerre en buvant des bières.~
@71310 = ~Au revoir. Que Tempus vous garde.~
@71311 = ~Alors ma fille vit encore. Tempus est miséricordieux, contre toute attente.~
@71312 = ~Ah. Tempus prélève sa dîme, comme toujours.~
@71313 = ~Bien sûr. Je vais la chercher moi-même. Merci.~
@71314 = ~Amulette de Mizhena~
@71315 = ~L'amulette de Mizhena

Je peux chercher l'amulette de Mizhena dans les bois, près du camp de la coalition.

Mizhena, une clerc de Tempus qui officie dans le camp de la coalition, a perdu une amulette lors d'un combat contre des croisés. L'amulette n'a qu'une valeur sentimentale, mais elle aimerait que je la retrouve. Je dois chercher les traces d'un combat dans les bois, près du camp.~
@71316 = ~L'amulette de Mizhena

J'ai rendu son amulette à Mizhena.

Mizhena, une clerc de Tempus qui officie dans le camp de la coalition, a perdu une amulette lors d'un combat contre des croisés. Je l'avais déjà trouvée dans les bois, près de camp, et je le lui ai dit. Elle a été très reconnaissante.~
@71317 = ~Cette amulette de bois simple est gravée du symbole sacré de Tempus sur son avers et de deux initiales sur son revers.

PARAMÈTRES :

Poids : 1~
@71318 = ~L'amulette de Mizhena

J'ai rendu son amulette à Mizhena.

Mizhena, une clerc de Tempus qui officie dans le camp de la coalition, a perdu une amulette lors d'un combat contre des croisés. L'amulette avait une grande valeur sentimentale, et j'ai réussi à la retrouver dans les bois, non loin. Elle a été très reconnaissante.~
@71319 = ~Le père de Mizhena~
@71320 = ~Le père de Mizhena

Je dois chercher le père de Mizhena, parmi les prisonniers de la croisade.

Mizhena me fait désormais confiance. Elle m'a donc demandé de chercher son père parmi les croisés. Apparemment, il a été fait prisonnier lorsque son groupe de soldats a attaqué le donjon.~
@71321 = ~Le père de Mizhena

J'ai appris à Mizhena que son père était mort.

Mizhena me fait désormais confiance. Elle m'a donc demandé de chercher son père parmi les croisés. Malheureusement, je l'avais déjà tué. Je l'ai dit à Mizhena, qui s'est mise en quête de son corps.~
@71322 = ~Le père de Mizhena

J'ai dit à Mizhena que j'avais trouvé son père.

Mizhena me fait désormais confiance. Elle m'a donc demandé de chercher son père parmi les croisés. Heureusement, je l'avais déjà trouvé. Elle a été fort soulagée de l'apprendre.~
@71323 = ~Le père de Mizhena

J'ai appris à Mizhena que son père était mort.

J'ai tué le père de Mizhena. Je le lui ai dit, et elle s'est mise en quête de son corps.~
@71324 = ~Le père de Mizhena

J'ai dit à Mizhena que j'avais trouvé son père.

J'ai appris à Mizhena que j'avais retrouvé son père. Elle a été fort soulagée de l'apprendre.~
@71325 = ~Le père de Mizhena

J'ai trouvé le père de Mizhena, vivant ; je n'ai plus qu'à le lui annoncer.

J'ai trouvé le père de Mizhena, en vie, dans la cour du château Paldragon. J'ai pu le libérer, avec d'autres prisonniers. Il faut avertir Mizhena.~
@71326 = ~Le père de Mizhena

Je peux dire à Mizhena que son père est mort.

J'ai trouvé le père de Mizhena dans la cour du château, mais je l'ai tué pour mes propres raisons. Je peux le dire à Mizhena, si je le désire.~
@71327 = ~Le père de Mizhena

J'ai trouvé le père de Mizhena, en vie, mais elle est morte.

J'ai trouvé le père de Mizhena, en vie, dans le château Paldragon. Il était reconnaissant que je le libère, mais attristé par la mort de sa fille.~
@71328 = ~Ma chandelle ! Ce n'est pas vous qui l'avez volée, de toute évidence. Comment l'avez-vous trouvée ?~
@71329 = ~J'essaie de découvrir qui l'a volée, en fait. Des idées ?~
@71330 = ~Gloire éclatante +3~
@71331 = ~Cette étoile du matin étincelante a été fabriquée par les forgerons du temple de Tempus, à Eauprofonde. Elle était destinée aux prêtres de Tempus, qui ne peuvent pas utiliser l'arme favorite de leur divinité, en raison de son tranchant. Gloire éclatante a un fer noir garni de pointes alternant entre or et rubis. Les enchantements durcissent ces pointes et ajoutent un éclat de feu à chaque frappe. Son porteur ne se fatigue jamais au combat, car il est habité par la volonté du Seigneur des Batailles en personne.

PARAMÈTRES :

Capacités d'équipement :
- Immunité à la fatigue

Capacités de combat :
- 10 % de chances de lancer le sort Cantique, centré sur le porteur

TAC0 : +3
Dégâts : 2d4 +3 (contondant), +1 (feu)
Facteur de vitesse : 4
Type de compétence : fléau d'armes/étoile du matin
Type : arme à une main
Nécessite :
 11 en Force

Poids : 8~
@71332 = ~Je pense mériter une récompense.~
@71333 = ~Nous sommes prisonniers. Aidez-nous !~
@71334 = ~Merci !~
@71335 = ~Écartez-vous de ces prisonniers !~
@71336 = ~Les drows fugueurs

J'ai exterminé une bande de drows.

Dans les souterrains en dessous de Paldragon, une bande de drows s'est retrouvée sur le chemin de la croisade, et sur le mien. Il semble évident qu'ils cherchaient les deux jeunes drows que j'ai rencontrés plus tôt. Peut-être que les leurs enverront d'autres chasseurs à leurs trousses...~
@71337 = ~Urold~
@71338 = ~Est-ce votre amulette ?~
@71339 = ~Mon amulette !~
@71340 = ~Heureusement, cela importe peu. Encore merci.~
@71341 = ~Onques ne parla-on avec autant de sagesse. Encore merci.~
@71342 = ~Que Tempus veille sur vous lors des combats à venir.~
@71343 = ~J'ai une autre faveur à vous demander. J'hésite à vous le demander, mais...~
@71344 = ~« La destinée mène qui la suit et entraîne qui lui résiste. »

Plutarque~
@71345 = ~Il y a à peine quelques semaines, le maléfique Sarevok a mené la ville de la Porte de Baldur au bord de la destruction.~
@71346 = ~Son héritage divin l'a poussé vers une destinée ténébreuse, une destinée que vous pourriez partager.~
@71347 = ~Comme lui, vous êtes un enfant de Bhaal le dieu du meurtre, à présent défunt. Bhaal avait vu sa propre mort et engendré des enfants mortels, afin de pouvoir revenir. Sarevok avait pour but de devenir le nouveau Seigneur du Meurtre.~ ~Comme lui, vous êtes une enfant de Bhaal le dieu du meurtre, à présent défunt. Bhaal avait vu sa propre mort et engendré des enfants mortels, afin de pouvoir revenir. Sarevok avait pour but de devenir le nouveau Seigneur du Meurtre.~
@71348 = ~Vous avez mis un terme aux projets de Sarevok, terrassant votre demi-frère. Avec sa mort, vous êtes devenu le héros de la Porte de Baldur.~ ~Vous avez mis un terme aux projets de Sarevok, terrassant votre demi-frère. Avec sa mort, vous êtes devenue l'héroïne de la Porte de Baldur.~
@71349 = ~Depuis lors, l'hospitalité du Grand-Duc Belt vous a permis, à vous et Imoen, votre amie de toujours, de vivre dans un confort et un luxe dont vous n'avez pas l'habitude, mais qui ne sont pas pour vous déplaire.~
@71350 = ~À présent, une nouvelle menace projette son ombre sur la ville. Une énorme armée lancée dans une croisade a semé le tumulte sur la Côte des Épées.~
@71351 = ~Depuis sa base, dans les ruines du tristement célèbre château Paldragon, dans la Haute Lande, cette force s'est répandue dans toutes les directions. Des mercenaires, des vétérans et des gens du commun ont rallié la bannière de la croisade.~
@71352 = ~Les victimes se comptent par milliers, les réfugiés par dizaines de milliers. Les croisés s'emparent des terres au nord de la Porte de Baldur. Les réfugiés s'entassent dans la ville et le Poing Enflammé ne pourra plus maintenir l'ordre bien longtemps.~
@71353 = ~On ne sait pas grand-chose concernant la cheffe de la croisade, la guerrière charismatique Caelar Argent. Ceux qui la suivent l'adorent sous le nom de Dame Étincelante, mais son passé et ses buts restent un mystère.~
@71354 = ~Certains prétendent qu'elle est d'origine divine, envoyée par les dieux pour écraser le mal, peu importe le prix. D'autres chuchotent que c'est une autre enfant de Bhaal et qu'elle a l'intention de suivre le même chemin que Sarevok.~
@71355 = ~En tout cas, une chose est évidente : pour que la Côte des Épées connaisse enfin la paix, Caelar Argent doit être arrêtée.~
@71356 = ~Parlez-moi plus tard. Nous sommes en plein combat...~
@71357 = ~Merci, je pensais l'avoir perdue pour toujours ! Néanmoins, je n'ai pas le temps de parler, il y a urgence. Vous n'avez sans doute pas le temps de m'aider ?~
@71358 = ~Nous sommes sur le point d'arrêter Caelar, une fois pour toutes. Mes excuses, mais je n'ai pas le temps.~
@71359 = ~Je comprends. Je demanderai à quelqu'un d'autre. Que Tempus soit avec vous.~
@71360 = ~Je préfère recevoir ma récompense et continuer mon chemin.~
@71361 = ~Alors, vous avez besoin d'aide ?~
@71362 = ~Au revoir.~
@71363 = ~C'est entendu. Au revoir.~
@71364 = ~Je ne doute pas qu'elle sera contente d'avoir de vos nouvelles. Au revoir.~
@71365 = ~Je ne crois pas. Un adepte de Tempus qui se réjouit de moisir dans une cage ? Vous me dégoûtez. Pas question de vous laisser vivre plus longtemps.~
@71366 = ~Les dieux sont parfois capricieux, mais cela tourne parfois au mieux pour nous. Au revoir.~
@71367 = ~La miséricorde est pour les faibles. Tempus ne peut qu'être mécontent que vous ayez été emprisonné par ces moins que rien. Je ne vous accorderai aucune pitié.~
@71368 = ~J'ai été désarmé et mis en cage, mais je ne me détournerai pas du combat ! TEMPUS !~
@71369 = ~Le portail est ouvert ! Courez, tous, votre vie en dépend ! Il reste peu de temps avant que les créatures de feu embrasent les tonneaux !~
@71370 = ~Le siège de Paldragon

Je dois empêcher les tonneaux d'être endommagés.

Le magicien de la croisade a réussi à ouvrir un portail temporaire vers le Plan élémentaire du feu, lequel crache des flammes et laisse passer ses habitants dans le plan matériel. Avec la chaleur intense qui en émane, il suffirait de la plus petite égratignure pour que le contenu des tonneaux s'embrase et engouffre tous les environs dans un enfer rageur.~
@71371 = ~L'amulette de Mizhena

J'ai rendu son amulette à Mizhena.

Mizhena, une clerc de Tempus, a perdu une amulette lors d'un combat contre des croisés. L'amulette avait une grande valeur sentimentale, et j'ai réussi à la retrouver dans les bois, près du camp de la coalition. Bien qu'elle ait été très reconnaissante, il est évident qu'un autre problème la tenaillait. Elle m'a à nouveau demandé de l'aide.~
@71372 = ~L'amulette de Mizhena

J'ai rendu son amulette à Mizhena.

Dans un bois près du camp de la coalition, j'ai trouvé une amulette qui appartenait en fait à Mizhena. Bien qu'elle ait été très reconnaissante, il est évident qu'un autre problème la tenaillait. Elle m'a à nouveau demandé de l'aide.~
@71373 = ~Impossible de trouver une sauvegarde de Baldur's Gate : Enhanced Edition valide. Pour en exporter une, lancez Baldur's Gate : Enhanced Edition chargez une sauvegarde, appuyez longuement sur le bouton Sauvegarde rapide, puis sélectionnez « Copie vers Le Siège de Paldragon », dans la fenêtre d'exportation.~
@71374 = ~Baldur's Gate : Le Siège de Paldragon est en cours de traduction dans d'autres langues par des douzaines de volontaires dévoués. Les langues supplémentaires seront fournies sous la forme de mises à jour gratuites, lorsqu'elles seront disponibles. Pour savoir quelles traductions sont en cours, veuillez visiter translate.baldursgate.com.~
@71375 = ~« Participe au Siège de Paldragon », qu'ils disaient. « Ce sera marrant », qu'ils disaient.~ [bdtpam01]
@71376 = ~Que faites-vous dans notre camp ?~
@71377 = ~J'étais supposé partir avec vous, mais vous ne m'avez pas attendu ! Heureusement, j'ai trouvé un raccourci et j'ai pu vous rattraper avec un minimum de pertes. Hélas ! Pauvre Philippe... Nous ne l'oublierons pas.~ [bdtpamb]
@71378 = ~A hero's work is never done. So, get to work and stop bothering me.~ [bdtpam08]
@71379 = ~Ah, Rasaad. Such a mournful fellow. Or maybe the sun was in his eyes.~ [bdtpam09]
@71380 = ~Commence our crusade of carnage!~ [bdtpbe01]
@71381 = ~Took you long enough! Now, to salvage this mismanaged mission.~ [bdtpbeb]
@71382 = ~Razzle dazzle, baby.~ [bdtpbe08]
@71383 = ~Let me show you the beauty underneath.~ [bdtpbe09]
@71384 = ~Meet your death!~ [bdtpag01]
@71385 = ~Hm, a sound decision.~ [bdtpagb]
@71386 = ~I will pet every dog.~ [bdtpag08]
@71387 = ~I now pronounce you man and knife.~ [bdtpag09]
@71388 = ~Get some!~ [bdtpdg01]
@71389 = ~Oh, movin' on up.~ [bdtpdgb]
@71390 = ~Buckle up, buttercup.~ [bdtpdg08]
@71391 = ~Zug zug, or whatever.~ [bdtpdg09]
@71392 = ~I guess we're doing this violently!~ [bdtpeh01]
@71393 = ~I'm in charge now? Neat.~ [bdtpehb]
@71394 = ~You wanna get striked?~ [bdtpeh08]
@71395 = ~God-babies can do infinite crime.~ [bdtpeh09]
@71396 = ~For honor!~ [bdtpsd01]
@71397 = ~Let us come together and follow a noble path.~ [bdtpsdb]
@71398 = ~Dark times bring out the light in all of us.~ [bdtpsd08]
@71399 = ~I'll always remember this adventure. And how you behaved.~ [bdtpsd09]
@71400 = ~For glory!~ [bdtpto01]
@71401 = ~Very well. I will lead.~ [bdtptob]
@71402 = ~Epic, epic, epic!~ [bdtpto08]
@71403 = ~Remember Dorn, the blackguard? He looked strangely familiar...~ [bdtpto09]
