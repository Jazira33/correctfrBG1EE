@13197 = ~Histoire d'Eauprofonde - volume II~
@13198 = ~Histoire d'Eauprofonde - volume III~
@13199 = ~Histoire d'Eauprofonde - volume IV~
@13200 = ~Histoire d'Eauprofonde - volume V~
@13201 = ~Histoire d'Eauprofonde - volume VI~
@13202 = ~Je n'ai rien à vous dire ! Pourquoi ne me laissez-vous pas tranquille !~
@13203 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13204 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13205 = ~Ne m'approchez pas ! Je vous préviens, je vous règle votre compte !~
@13206 = ~Vous êtes là pour me parler ? Imbécile ! Vous n'obtiendrez rien de plus que mon épée dans le ventre !~
@13207 = ~Vous avez tenté de m'attaquer ! Vous en mourrez !~
@13208 = ~Si vous osez revenir après m'avoir attaqué, je vous tuerai !~
@13209 = ~Vous avez abusé de notre hospitalité !~
@13210 = ~Plutôt crever que de vous faire confiance !~
@13211 = ~Pourquoi ne pas aller implorer de l'aide autre part. Vous ne tirerez rien de moi !~
@13212 = ~Vous allez mourir à cause de ça ! MOURIR !~
@13213 = ~Plus de pourparlers ni accords possibles ! La mort est tout ce qui vous attend !~
@13214 = ~Ne venez pas me déranger, petits hommes.~
@13215 = ~Je vous servirai en buffet froid ! Les gars, avec moi !~
@13216 = ~Vous avez abusé de notre hospitalité !~
@13217 = ~Plus de pourparlers ni accords possibles ! La mort est tout ce qui vous attend !~
@13218 = ~Vous ne vous êtes pas fait que des amis par ici ! Du vent !~
@13219 = ~Vous ne vous êtes pas fait que des amis par ici ! Du vent !~
@13220 = ~Désolé, mais je n'ai pas de temps à perdre en bavardages. Je dois répandre la bonne parole.~
@13221 = ~Je suppose que cela fait partie de mon devoir que de souffrir votre compagnie. Mais je ne prolongerai pas une telle expérience.~
@13222 = ~Vous ne vous êtes pas fait que des amis par ici ! Du vent !~
@13223 = ~Laissez-moi tranquille ! Vous êtes d'une méchanceté incroyable !~
@13224 = ~Laissez-moi tranquille ! Vous êtes d'une méchanceté incroyable !~
@13225 = ~Laissez-moi tranquille ! Vous êtes d'une méchanceté incroyable !~
@13226 = ~Laissez-moi tranquille ! Vous êtes d'une méchanceté incroyable !~
@13227 = ~Laissez-moi tranquille ! Vous êtes d'une méchanceté incroyable !~
@13228 = ~C'est bien bon de vous revoir. J'ai peu de temps pour le moment, alors parlons plus tard.~
@13229 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13230 = ~Je n'ai rien à dire à aucun d'entre vous.~
@13231 = ~Je dois vous remercier encore une fois pour le service rendu.~
@13232 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13233 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13234 = ~On va vous botter le derrière pour ce que vous avez fait !~
@13235 = ~Allez au diable, nous ne voulons pas vous parler.~
@13236 = ~Je n'ai pas de temps à perdre avec vous pour le moment, alors je vous prierais de déguerpir.~
@13237 = ~Je n'ai pas de temps à perdre avec vous pour le moment, alors je vous prierais de déguerpir.~
@13238 = ~J'ai beaucoup à apprendre, mais au moins je vivrai assez longtemps pour l'apprendre.~
@13239 = ~Vous ne vous êtes pas fait que des amis par ici ! Déguerpissez !~
@13240 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13241 = ~Alors c'est vous les héros ! Je veux vous ressembler plus tard.~
@13242 = ~Laissez-moi ! Vous m'embêtez !~
@13243 = ~Je n'ai pas le temps de parler, j'ai des wivernes à tuer.~
@13244 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13245 = ~Vous n'auriez pas dû revenir ! À présent, vous ne repartirez plus !~
@13246 = ~Laissez-moi !~
@13247 = ~Vous auriez dû partir lorsqu'il était encore temps ! À présent, nous allons enterrer vos restes au fin fond d'une grotte !~
@13248 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13249 = ~Je n'ai franchement plus grand-chose à vous dire.~
@13250 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13251 = ~Je n'ai pas envie de parler pour le moment. J'vais m'asseoir avec ces beautés.~
@13252 = ~Je quitte cet endroit maudit ; je n'ai pas le temps de vous parler.~
@13253 = ~Il ne faut pas qu'on me voie parler à des gens de votre espèce. Laissez-moi !~
@13254 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13255 = ~J'ai beaucoup de choses à faire, tout comme vous. Alors veuillez me laisser à présent.~
@13256 = ~J'espère que votre enquête avance.~
@13257 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13258 = ~Je... je ne peux pas vous parler. Je veux simplement... qu'on me laisse tranquille.~
@13259 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13260 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13261 = ~Vous avez prouvé qu'on ne pouvait pas vous faire confiance, mais je n'ai toujours pas le choix. Retrouvez mes compagnons.~
@13262 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13263 = ~Sous prétexte que N'IMPORTE QUI est le bienvenu dans les caves souterraines, on pense qu'on est le bienvenu dans mon bureau personnel. Si c'était le cas, je ne vivrais pas dans cette boucherie. Je vous demande une fois de plus de partir.~
@13264 = ~Vous avez abusé de notre hospitalité !~
@13265 = ~Je ne tolérerai pas votre présence une minute de plus.~
@13266 = ~Notre bosquet est sacré, et nous souhaitons qu'il reste un endroit privé. Alors partez avant que nous vous chassions.~
@13267 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13268 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13269 = ~Laissez-moi !~
@13270 = ~Que faites-vous encore ici ? Vous avez beaucoup à faire, dépêchez-vous !~
@13271 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13272 = ~Ne m'ennuyez pas, sauvages ignorants.~
@13273 = ~J'espère que l'exploration de la mine se passe bien.~
@13274 = ~Vous avez... fait du bon boulot. Je vous souhaite bonne chance pour vos futurs voyages.~
@13275 = ~Vous ne vous êtes pas fait que des amis par ici ! Déguerpissez !~
@13276 = ~Ma porte n'est plus ouverte aux individus de votre espèce !~
@13277 = ~Partez, je n'ai nulle envie de vous parler.~
@13278 = ~J'ai entendu dire que les mines étaient de nouveau opérationnelles.~
@13279 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13280 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13281 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13282 = ~Désolé, je dois partir. Ma femme m'attend, et je lui manque sans doute déjà.~
@13283 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13284 = ~Je ne veux pas de votre aide.~
@13285 = ~Hors de ma vue ! Je ne ferai rien pour vous !~
@13286 = ~Sortez ou on vous jettera dehors !~
@13287 = ~Sortez ou on vous jettera dehors !~
@13288 = ~Désolée, rien à manger pour vous pour le moment.~
@13289 = ~Sortez ou on vous jettera dehors !~
@13290 = ~Houh ! Stupides joueurs. Apprenez à vous servir d'une épée et vous n'aurez jamais le ventre vide. Surtout à la Porte où les ruelles grouillent de proies.~
@13291 = ~Hors de ma vue ! Je ne ferai rien pour vous !~
@13292 = ~Je ne dirai pas un mot après ce que vous avez fait !~
@13293 = ~Je ne dirai pas un mot après ce que vous avez fait !~
@13294 = ~df~
@13295 = ~Je ne dirai pas un mot après ce que vous avez fait !~
@13296 = ~Je ne dirai pas un mot après ce que vous avez fait !~
@13297 = ~Je ne dirai pas un mot après ce que vous avez fait !~
@13298 = ~Laissez-moi tranquille s'il vous plaît. Je pleure la mort de mon mari.~
@13299 = ~Culotte dorée~
@13300 = ~Samuel~
@13301 = ~Je ne dirai pas un mot après ce que vous avez fait !~
@13302 = ~Culotte dorée~
@13303 = ~Samuel~
@13304 = ~Je ne dirai pas un mot après ce que vous avez fait !~
@13305 = ~Je ne dirai pas un mot après ce que vous avez fait !~
@13306 = ~Je vous flanque une gifle si vous faites un pas de plus !~
@13307 = ~Je vous flanque une gifle si vous faites un pas de plus !~
@13308 = ~Laissez-moi tranquille !~
@13309 = ~On ne veut pas de vous ici !~
@13310 = ~On ne veut pas de vous ici !~
@13311 = ~On ne veut pas de vous ici !~
@13312 = ~On ne veut pas de vous ici !~
@13313 = ~On ne veut pas de vous ici !~
@13314 = ~On ne veut pas de vous ici !~
@13315 = ~On ne veut pas de vous ici !~
@13316 = ~On ne veut pas de vous ici !~
@13317 = ~On ne veut pas de vous ici !~
@13318 = ~On ne veut pas de vous ici !~
@13319 = ~On ne veut pas de vous ici !~
@13320 = ~On ne veut pas de vous ici !~
@13321 = ~Vous répondrez de vos crimes ou mourrez sur place !~
@13322 = ~On ne veut pas de vous ici !~
@13323 = ~Vous n'avez pas d'amis ici ! Circulez !~
@13324 = ~Les affaires n'ont pas très bien marché ces derniers temps avec tous les problèmes dans le Sud. Mais j'ai entendu dire que les mines de Nashkel avaient rouvert. Des gars héroïques se sont occupés de la cause du fléau.~
@13325 = ~Bas les pattes !~
@13326 = ~Je ne dirai pas un mot après ce que vous avez fait ! Je me procurerai cet artefact stupide et le vendrai par mes propres moyens.~
@13327 = ~Mesdames et messieurs, approchez-vous et faites vos jeux ! Vous êtes dans une maison honnête où tout le monde peut faire fortune ! Quiconque prétend le contraire va tâter de la hache de l'aubergiste !~
@13328 = ~Je m'excuse, jeune personne ; j'aimerais poursuivre cette conversation mais j'ai du pain sur la planche aujourd'hui.~
@13329 = ~Laissez-moi tranquille ! Quelle cruauté !~
@13330 = ~Laissez-moi tranquille ! Quelle cruauté !~
@13331 = ~Laissez-moi tranquille ! Quelle cruauté !~
@13332 = ~Laissez-moi tranquille ! Quelle cruauté !~
@13333 = ~Vous ne perdez rien pour attendre. Nous vous tuerons de toute manière !~
@13334 = ~Ce que vous avez fait vous coûtera votre tête !~
@13335 = ~On ne veut pas de vous ici !~
@13336 = ~On ne veut pas de vous ici !~
@13337 = ~J'imagine que vous avez trouvé accueillante la population de notre petit village ? Nous aimons faire bon accueil aux étrangers.~
@13338 = ~Et moi, je préférerais oublier que nous nous sommes jamais rencontrés. Comme ça, je pourrais vous rencontrer de nouveau comme si c'était la première fois et je n'aurais pas à vous détester.~
@13339 = ~Sans vouloir vous offenser, j'aimerais vous voir partir immédiatement. On ne peut pas vous faire confiance.~
@13340 = ~Fallait vous enfuir quand vous en aviez l'occasion ! Maintenant nous allons vous dépouiller de votre argent.~
@13341 = ~Quel plaisir de vous revoir ! Je suis heureuse que vous soyez encore plus ou moins en vie. Cela nous arrive souvent de revoir un aventurier mais il est nettement moins bavard la seconde fois. La mort vous fera le même effet. Un aléa de la vie, je suppose...~
@13342 = ~Vous êtes toujours en vie ! Hum... ne vous vexez pas. C'est qu'il ne nous arrive pas souvent de voir des aventuriers deux fois de suite, à moins que ce ne soit dans une caisse prête à être envoyée au cimetière. Je ne critique pas vos compétences mais je ne m'attendais pas à vous revoir. Je vous souhaite bonne chance pour la suite de vos voyages.~
@13343 = ~Vous avez abusé de mon hospitalité !~
@13344 = ~Bien le bonjour de nouveau. Je pensais que vous aviez déjà repris la route. Quel plaisir que ce ne soit pas le cas.~
@13345 = ~Quelle surprise de vous revoir. L'appel du vagabond aurait-il de nouveau pris possession de votre logique ? Par Dallillia, j'espère qu'aucun de ces enfants ne vous suit dans vos pérégrinations.~
@13346 = ~Vous avez abusé de mon hospitalité !~
@13347 = ~Rebonjour. C'est toujours le même plaisir.~
@13348 = ~Je vois que vous êtes de retour. J'imagine que vous n'allez pas rester plus longtemps que la dernière fois ?~
@13349 = ~Sans vouloir vous offenser, j'aimerais vous voir partir immédiatement.~
@13350 = ~Quelle chance de vous rencontrer de nouveau ! J'aime tant nos petites conversations.~
@13351 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13352 = ~Sortez, ou je vous fais jeter dehors !~
@13353 = ~Sortez, ou je vous fais jeter dehors !~
@13354 = ~Désolée, il n'y a rien à manger pour vous pour l'instant.~
@13355 = ~Sortez, ou je vous fais jeter dehors !~
@13356 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13357 = ~Bah ! Bande de flambeurs. Apprenez à manier l'épée et vous n'aurez jamais faim. En particulier dans le Passage, dont les allées regorgent toujours de proies.~
@13358 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13359 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13360 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13361 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13362 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13363 = ~Ne m'ennuyez pas. Je pleure la mort de mon mari.~
@13364 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13365 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13366 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13367 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13368 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13369 = ~Laissez-moi !~
@13370 = ~Vous n'avez rien à faire ici !~
@13371 = ~Vous n'avez rien à faire ici !~
@13372 = ~Vous n'avez rien à faire ici !~
@13373 = ~Vous n'avez rien à faire ici !~
@13374 = ~Vous n'avez rien à faire ici !~
@13375 = ~Vous n'avez rien à faire ici !~
@13376 = ~Vous n'avez rien à faire ici !~
@13377 = ~Vous n'avez rien à faire ici !~
@13378 = ~Vous n'avez rien à faire ici !~
@13379 = ~Vous n'avez rien à faire ici !~
@13380 = ~Vous n'avez rien à faire ici !~
@13381 = ~Vous n'avez rien à faire ici !~
@13382 = ~Vous répondrez de vos crimes, ou mourrez ici !~
@13383 = ~Vous n'avez rien à faire ici !~
@13384 = ~Vous ne vous êtes pas fait que des amis par ici ! Déguerpissez !~
@13385 = ~Les affaires ont plutôt mal marché ces derniers temps à cause des problèmes dans le Sud. Mais j'ai entendu dire que les mines de Nashkel avaient rouvert. Quelque héros s'est chargé d'éliminer la cause du fléau.~ ~Les affaires ont plutôt mal marché ces derniers temps à cause des problèmes dans le Sud. Mais j'ai entendu dire que les mines de Nashkel avaient rouvert. Quelque héroïne s'est chargée d'éliminer la cause du fléau.~
@13386 = ~Laissez-moi !~
@13387 = ~Je ne dirai plus rien après ce que vous avez fait ! Je trouverai cet objet et le vendrai sans l'aide de personne.~
@13388 = ~Entrez et jouez, mesdames et messieurs ! Ceci est une maison honnête et tout le monde a une chance de devenir riche ! Quiconque oserait prétendre le contraire ferait mieux de s'entretenir avec la hache de l'aubergiste !~
@13389 = ~Laissez-moi ! Vous m'embêtez !~
@13390 = ~Je m'excuse, j'aimerais bien rester discuter avec vous, mais j'ai du pain sur la planche aujourd'hui.~
@13391 = ~Laissez-moi ! Vous m'embêtez !~
@13392 = ~Laissez-moi ! Vous m'embêtez !~
@13393 = ~Laissez-moi ! Vous m'embêtez !~
@13394 = ~Vous avez assez attendu, maintenant nous vous tuerons quoi qu'il arrive !~
@13395 = ~Je vous couperai la tête pour ce que vous avez fait !~
@13396 = ~Vous n'avez rien à faire ici !~
@13397 = ~Vous n'avez rien à faire ici !~
@13398 = ~Je suppose que vous avez trouvé la population de notre village plutôt accueillante ? Nous aimons tellement accueillir des étrangers.~
@13399 = ~J'aimerais oublier jusqu'à notre rencontre ! Je pourrais ainsi vous voir comme pour la première fois, ce qui m'éviterait d'avoir à vous détester.~
@13400 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ. Vous n'êtes pas digne de confiance.~
@13401 = ~Vous auriez dû vous enfuir quand il en était encore temps. Maintenant, nous allons prendre votre argent.~
@13402 = ~C'est bon de vous revoir. Cela me fait plaisir de voir que vous êtes toujours plus ou moins en vie. Il n'est pas rare de voir un aventurier deux fois, mais en général il est bien moins expansif la deuxième fois. La mort vous fera cet effet aussi. Un hasard de la vie, je suppose.~
@13403 = ~Toujours en vie ! Euh... sauf votre respect. C'est juste qu'il est bien rare de voir un aventurier une deuxième fois, sauf mort et enterré. Sans vouloir douter de vos capacités, je n'aurais jamais pensé vous revoir. Je vous souhaite bonne chance pour vos futurs voyages.~
@13404 = ~Vous avez abusé de notre hospitalité !~
@13405 = ~Bienvenue de nouveau. J'aurais pensé que vous seriez loin à l'heure qu'il est. C'est toutefois un plaisir de voir ici.~
@13406 = ~Je m'étonne de vous revoir. L'appel de l'aventure aurait-il une fois de plus eu raison de vous ? Par Dallillia, j'espère qu'aucun enfant ne vous suivra lorsque vous partirez.~
@13407 = ~Vous avez abusé de notre hospitalité !~
@13408 = ~Re-bonjour. C'est toujours un plaisir.~
@13409 = ~Ainsi vous voilà de retour. Je suppose que vous ne resterez pas plus longtemps que la dernière fois ?~
@13410 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13411 = ~Nouvelle rencontre. J'apprécie tellement nos petites discussions.~
@13412 = ~Je vous retrouve chez moi. Sachez vous tenir, et vous serez ici chez vous.~
@13413 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13414 = ~Re-bonjour ! Vous feriez mieux de vous tenir tranquille, car Nanna ne veut pas que vous me fassiez partir.~
@13415 = ~Du vent ! Je vous présenterai à tout le monde bien assez tôt !~
@13416 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13417 = ~Ça fait plaisir de vous savoir toujours en vie, mais je vous saurais gré de ne pas rester trop longtemps chez moi.~
@13418 = ~Vous ne causez que du trouble chez moi. Sans vouloir vous offenser... mais c'est le cas.~
@13419 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13420 = ~De retour ? Je m'étonne que vous n'ayez pas rejoint de nouveaux endroits merveilleux plutôt que de revenir dans cette humble demeure. Vous pouvez rester autant que vous le voudrez, mais je sais que vous nous quitterez bientôt.~
@13421 = ~Ah, je vois que vous avez survécu un jour de plus. Peut-être avez-vous enfin appris à maîtriser votre esprit d'indépendance... ou alors peut-être que vous savez retomber vite sur vos pieds. Que la chance soit avec vous au cours de vos voyages.~
@13422 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13423 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13424 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13425 = ~Sortez, ou je vous fais jeter dehors !~
@13426 = ~Je m'excuse, mais j'ai du travail, et je n'ai pas le temps de bavarder pour le moment.~
@13427 = ~Sortez, ou je vous fais jeter dehors !~
@13428 = ~Sortez, ou je vous fais jeter dehors !~
@13429 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13430 = ~J'ai vraiment beaucoup de travail maintenant, alors je vais devoir vous demander de revenir plus tard.~
@13431 = ~Vous feriez mieux de ne pas rester dans les parages. Vous risqueriez d'attirer l'attention sur le Duc Eltan.~
@13432 = ~Vous ne vous êtes pas fait que des amis par ici ! Déguerpissez !~
@13433 = ~Laissez-moi croupir !~
@13434 = ~Laissez-moi tranquille !~
@13435 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13436 = ~Hors de ma vue.~
@13437 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13438 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13439 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13440 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13441 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13442 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13443 = ~Excusez-moi, mais je dois aller retrouver ma femme et mes enfants.~
@13444 = ~Laissez-moi ! Je ne vous ferais pas confiance pour tout l'or du monde !~
@13445 = ~Ça me fait vraiment plaisir de vous revoir. Faites comme chez vous.~
@13446 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13447 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13448 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13449 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13450 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13451 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13452 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13453 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13454 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13455 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13456 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13457 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13458 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13459 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13460 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13461 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13462 = ~S'il vous plaît ? J'ai beaucoup à faire, et je n'ai pas besoin de ces interruptions incessantes.~
@13463 = ~Vous ne vous êtes pas fait que des amis par ici ! Déguerpissez !~
@13464 = ~Laissez-moi ! Je ne vous ferais pas confiance pour tout l'or du monde !~
@13465 = ~Je vous demande de ne plus me déranger, car j'ai de nombreuses questions financières à régler.~
@13466 = ~Je vous conseille de ne pas trop vous éterniser.~
@13467 = ~Vous ne valez guère mieux que mes ravisseurs ! Laissez-moi !~
@13468 = ~Sortez de ma boutique ! On ne veut pas de vous ici.~
@13469 = ~Laissez-moi ! Je ne vous ferais pas confiance pour tout l'or du monde !~
@13470 = ~Sans vouloir vous offenser, je ne désire pas que vous restiez. Laissez-moi à mes affaires.~
@13471 = ~Re-bonjour. Je suppose que vous trouvez ma taverne à votre goût ? Je m'applique à la rendre agréable à tout le monde.~
@13472 = ~Vous me dégoûtez. Laissez-moi !~
@13473 = ~Laissez-moi donc en paix.~
@13474 = ~Je suppose que tout va comme vous voulez ? N'hésitez pas à quitter les lieux si ce n'est pas le cas.~
@13475 = ~Re-bonjour. C'est vraiment un plaisir de vous avoir parmi nous.~
@13476 = ~Vous ne vous êtes pas fait que des amis par ici ! Déguerpissez !~
@13477 = ~Vous ne vous êtes pas fait que des amis par ici ! Déguerpissez !~
@13478 = ~Je ne vous ferais pas confiance pour tout l'or du monde !~
@13479 = ~Hé, débarrassez le plancher. Je n'ai pas besoin de vous voir traîner dans ma cuisine ! *soupire* J'aspire à travailler dans un endroit où la bière et le sang ne servent pas d'assaisonnement.~
@13480 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13481 = ~Dehors ! Et que je ne vous revoie plus jamais chez moi !~
@13482 = ~Encore vous ! Par les griffes d'Umberlie, je ne supporterai pas ces interruptions très longtemps. Sortez de ma cuisine, et n'y revenez plus.~
@13483 = ~Dehors ! Et que je ne vous revoie plus jamais chez moi !~
@13484 = ~Ma porte n'est plus ouverte aux individus de votre espèce !~
@13485 = ~Ma porte n'est plus ouverte aux individus de votre espèce !~
@13486 = ~J'espère que vous passez une super soirée ; en tout cas, moi, oui.~
@13487 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13488 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13489 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13490 = ~Faites taire ce maudit barde avant que je lui botte les fesses !~
@13491 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13492 = ~Ne vous avisez pas d'aller déranger les personnes assises à cette table. Vous risqueriez d'attraper un mauvais coup.~
@13493 = ~Laissez-moi ! Vous avez abusé de notre hospitalité !~
@13494 = ~Laissez-moi ! Vous avez abusé de notre hospitalité !~
@13495 = ~Laissez-moi ! Vous avez abusé de notre hospitalité !~
@13496 = ~Laissez-moi ! Vous avez abusé de notre hospitalité !~
@13497 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13498 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13499 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13500 = ~Laissez-moi ! Je ne vous ferais pas confiance pour tout l'or du monde !~
@13501 = ~Encore vous ? Laissez-moi tranquille.~
@13502 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13503 = ~Vous aurez la tête tranchée pour ce que vous avez fait !~
@13504 = ~Je ne vous ferais pas confiance pour tout l'or du monde !~
@13505 = ~Je ne vous ferais pas confiance pour tout l'or du monde !~
@13506 = ~Je ne vous ferais pas confiance pour tout l'or du monde !~
@13507 = ~Rien à voir ici, monsieur !~
@13508 = ~Vous n'avez rien à faire ici !~
@13509 = ~Cessez de me déranger, j'ai beaucoup à faire.~
@13510 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13511 = ~Nous vous remercions d'avoir arrêté cette vilaine sorcière avant qu'elle nous tue. Tenez, prenez ça en gage de reconnaissance.~
@13512 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13513 = ~Laissez-moi ! Je ne me sens pas plus en sécurité avec vous qu'avec mes ravisseurs !~
@13514 = ~Laissez-moi ! Je ne me sens pas plus en sécurité avec vous qu'avec mes ravisseurs !~
@13515 = ~Laissez-moi ! Je ne me sens pas plus en sécurité avec vous qu'avec mes ravisseurs !~
@13516 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13517 = ~Laissez-moi !~
@13518 = ~Laissez-moi !~
@13519 = ~Vous ne vous êtes pas fait que des amis par ici ! Déguerpissez !~
@13520 = ~Je vous scalperai pour avoir osé venir ici ! Vous allez tout faire rater !~
@13521 = ~Vous avez abusé de notre hospitalité ! Débarrassez le plancher !~
@13522 = ~Ne me parlez plus, vous m'ennuyez.~
@13523 = ~Vous êtes encore là ? J'aime bien la plaisanterie, mais vous feriez mieux maintenant de déguerpir, et en vitesse !~
@13524 = ~La petite fête n'est pas ENCORE terminée ? C'est incroyable qu'ils ne se soient pas tous endormis sur place.~
@13525 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13526 = ~Vous ne valez guère plus que les animaux que je chasse ! Débarrassez-moi le plancher !~
@13527 = ~Encore vous ? C'est une bonne surprise, même si Carl et Jurgen n'en donnent pas l'impression. Cependant, n'abusez pas de mon hospitalité, car je n'ai pas l'habitude des visites prolongées.~
@13528 = ~Vous faites assurément partie des parasites les plus têtus qu'il m'ait été donné de connaître. Je vous demande de nouveau de partir ou alors on vous « escortera » dehors.~
@13529 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13530 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13531 = ~Vous auriez tout de même pu vous arranger un peu avant de venir ici. Il s'agit de l'événement de l'année et à vous voir on croirait que vous avez dû vous battre contre un garde pour entrer. C'est une honte.~
@13532 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13533 = ~L'occasion est lugubre. Je vous demanderai d'éviter de mal vous comporter.~
@13534 = ~Débarrassez le plancher !~
@13535 = ~Ooo, mais on dirait un vrai bal masqué. Il faudra que je revienne lorsque je pourrai me payer vos services.~
@13536 = ~Ne vous approchez pas de moi ou je vous tanne le cuir !~
@13537 = ~Ne vous approchez pas de moi ou je vous tanne le cuir !~
@13538 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13539 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13540 = ~Je pense que vous devriez partir avant d'effrayer la m'dame.~
@13541 = ~Vous voilà donc de retour ?! Pourquoi n'attaquez-vous pas le garde si vous avez tellement hâte de semer le trouble. Partez sur-le-champ ou je déclenche l'alarme.~
@13542 = ~Hum, je trouve étrange que vous ayez confondu votre chambre avec la mienne une fois de plus. Je vous prie de partir.~
@13543 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13544 = ~Encore vous ? Je vous serais reconnaissant de me laisser tant que je ne désire pas votre compagnie. Je vous souhaite bien le bonjour.~
@13545 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13546 = ~Je crois vous avoir déjà demandé de me laisser. Faites ce que je vous dis, ou nous en regretterons tous deux les conséquences.~
@13547 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13548 = ~Vous osez venir me déranger une fois de plus ? Vous cherchez vraiment les ennuis, n'est-ce pas ? Heureusement pour vous, je suis décidé à vous ignorer.~
@13549 = ~Ne vous approchez pas de moi ou je vous tanne le cuir !~
@13550 = ~Je ne vous laisserai pas approcher !~
@13551 = ~Je ne vous laisserai pas approcher !~
@13552 = ~Je vous serais infiniment reconnaissante de bien vouloir me laisser !~
@13553 = ~Je croyais qu'il fallait une invitation pour pouvoir entrer. Qui a laissé passer un agitateur tel que vous ?~
@13554 = ~Je ne vous laisserai pas approcher !~
@13555 = ~Quelque chose... il y a quelque chose qui cloche chez cet homme corpulent. Peut-être ai-je tout simplement de la fièvre, mais il y a quelque chose...~
@13556 = ~Je ne vous laisserai pas approcher !~
@13557 = ~Je ne vous laisserai pas approcher !~
@13558 = ~Je ne vous laisserai pas approcher ! J'ai autre chose à faire que de traîner avec des individus de votre espèce !~
@13559 = ~Re-bonjour.~
@13560 = ~Je ne vous laisserai pas approcher !~
@13561 = ~Je ne vous laisserai pas approcher !~
@13562 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13563 = ~Vous avez mal agi ! Vous paierez pour vos actes !~
@13564 = ~Je me demande ce que vous faites ici ! Hors de ma vue !~
@13565 = ~Vous avez mal agi ! Vous paierez pour vos actes !~
@13566 = ~Vous avez mal agi ! Vous paierez pour vos actes !~
@13567 = ~Je m'excuse, mais j'ai du pain sur la planche.~
@13568 = ~Ma porte n'est plus ouverte aux individus de votre espèce !~
@13569 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13570 = ~Sans vouloir vous offenser, je préférerais que vous me laissiez. J'ai quelques modifications à apporter à mon poème épique.~
@13571 = ~Je perds mon temps avec vous. Laissez-moi.~
@13572 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13573 = ~Je vous conseille de déguerpir. Tout de suite.~
@13574 = ~Je vous conseille de déguerpir. Tout de suite.~
@13575 = ~J'ai de nombreux patients à voir, et je dois vous demander de me laisser.~
@13576 = ~Je vous conseille de déguerpir. Tout de suite.~
@13577 = ~Je vous conseille de déguerpir. Tout de suite.~
@13578 = ~Je vous conseille de déguerpir. Tout de suite.~
@13579 = ~Vous avez abusé de notre hospitalité !~
@13580 = ~Vous n'obtiendrez rien de moi !~
@13581 = ~Vous n'obtiendrez rien de moi !~
@13582 = ~Si vous osez encore m'approcher, je ferai servir vos entrailles sur un plateau !~
@13583 = ~Je vous ai dit que j'avais du travail ! Maintenant, laissez-moi !~
@13584 = ~Si vous osez encore m'approcher, je ferai servir vos entrailles sur un plateau !~
@13585 = ~Fichez-moi le camp, je ne veux pas de crâneur tel que vous par ici.~
@13586 = ~Si vous osez encore m'approcher, je ferai servir vos entrailles sur un plateau !~
@13587 = ~Pièce d'or~
@13588 = ~N'allez pas trafiquer avec ces apprenties. Faites-moi plutôt confiance à moi, je connais le métier mieux que personne.~
@13589 = ~Si vous osez encore m'approcher, je ferai servir vos entrailles sur un plateau !~
@13590 = ~Pourquoi ai-je l'impression que, de là où vous venez, « faire la cour » équivaut à chasser du laideron ? Hors de mon chemin, j'ai un exploitant grippe-sous à rembourser.~
@13591 = ~Si vous osez encore m'approcher, je ferai servir vos entrailles sur un plateau !~
@13592 = ~Hors de mon chemin, bande d'empotés !~
@13593 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13594 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13595 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13596 = ~Vous paierez pour vos actes !~
@13597 = ~Eh, quoi ? Je m'excuse, mais je n'ai pas le temps de bavarder pour le moment. Je m'en vais sous des cieux plus cléments.~
@13598 = ~Je pense que vous devriez m'éviter. Je vous déteste de plus en plus, et on m'appelle pas petits bras.~
@13599 = ~Vous avez laissé passé votre chance avec moi, il est trop tard ! Du vent ! Je vous ferai découper en petits morceaux si vous ne partez pas sur-le-champ !~
@13600 = ~Laissez-moi ou vous ne serez plus de ce monde à l'aube !~
@13601 = ~Laissez-moi ou vous ne serez plus de ce monde à l'aube !~
@13602 = ~Bonjour. Je m'appelle Séniyad. Je vous signale que ces terres sont sous ma protection. Si vous en perturbez la quiétude, vous en paieriez las conséquences. Tenez-vous le pour dit.~
@13603 = ~Je ne dirai pas un mot après ce que vous avez fait !~
@13604 = ~Excusez-moi mais j'ai beaucoup du travail devant moi.~
@13605 = ~Sans vouloir vous offenser, j'aimerais vous voir partir immédiatement.~
@13606 = ~Sans vouloir vous offenser, j'aimerais vous voir partir immédiatement.~
@13607 = ~Laissez encore une fois traîner votre main baladeuse et je vous la coupe. Juré ! Allez-vous faire servir au bar.~
@13608 = ~Mes hommages. Je suis Séniyad. Je vous préviens, ce sont mes terres protégées. Si vous perturbez leur équilibre, les représailles seront sévères. Tenez-vous le pour dit.~
@13609 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13610 = ~Excusez-moi, mais j'ai du pain sur la planche.~
@13611 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13612 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13613 = ~Si vous osez tâter la marchandise une nouvelle fois, je vous coupe la main ! Commandez au bar.~
@13614 = ~Hors de ma vue, espèce de stupide imbécile !~
@13615 = ~Sortez, ou je vous fais jeter dehors !~
@13616 = ~J'souhaite que les bonstres d'ici vous attrabent !~
@13617 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13618 = ~Je vous prie de m'excuser, mais j'ai beaucoup à faire pour le moment.~
@13619 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13620 = ~Laissez-moi tranquille !~
@13621 = ~Laissez-moi tranquille !~
@13622 = ~Laissez-moi tranquille !~
@13623 = ~Laissez-moi tranquille !~
@13624 = ~Laissez-moi tranquille !~
@13625 = ~Laissez-moi tranquille !~
@13626 = ~J'espère que vous avez appris les bonnes manières depuis notre dernière rencontre ? Sinon, prenez la porte.~
@13627 = ~Bienvenue de nouveau parmi nous. J'espère que nous pourrons vous aider.~
@13628 = ~Je ne vous ferais pas confiance pour tout l'or du monde !~
@13629 = ~Vous ne vous êtes pas fait que des amis par ici ! Déguerpissez !~
@13630 = ~Laissez-moi tranquille, ou vous le regretterez !~
@13631 = ~Je vous apprendrai le respect ! Vous ne sortirez pas d'ici debout !~
@13632 = ~Misérables avortons ! Hors de mon chemin, où je vous crève les yeux !~
@13633 = ~Vous ne vous êtes pas fait que des amis par ici ! Déguerpissez !~
@13634 = ~Votre mort me fera le plus grand plaisir !~
@13635 = ~Impie ! J'aurai votre peau !~
@13636 = ~Attendez un peu ! Vous allez recevoir une correction bien méritée !~
@13637 = ~Je vous ai déjà dit que je ne voulais pas de vous ici ! Partez maintenant !~
@13638 = ~Vous avez abusé de notre hospitalité !~
@13639 = ~Je n'ai pas plus de patience que lorsque vous vous êtes introduit ici pour la première fois. Partez, où vous le regretterez pour le reste de votre très courte vie !~ ~Je n'ai pas plus de patience que lorsque vous vous êtes introduite ici pour la première fois. Partez, où vous le regretterez pour le reste de votre très courte vie !~
@13640 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13641 = ~Laissez-moi tranquille !~
@13642 = ~Laissez-moi tranquille !~
@13643 = ~À votre place, je ne traînerais pas trop dans les parages. Maman peut devenir très méchante quand on l'énerve.~
@13644 = ~Laissez-moi tranquille !~
@13645 = ~Vous n'avez rien à faire ici !~
@13646 = ~Si vous ne partez pas sur-le-champ, je demanderai à quelqu'un de venir vous y « aider ».~
@13647 = ~Vous n'avez rien à faire ici !~
@13648 = ~Vous n'avez rien à faire ici !~
@13649 = ~Vous n'obtiendrez rien de moi !~
@13650 = ~Laissez-moi !~
@13651 = ~Vous ne vous êtes pas fait que des amis par ici ! Déguerpissez !~
@13652 = ~Bonjour, ça va ? Oh, c'est encore vous. Si vous voulez bien m'excuser, je ne suis pas franchement d'humeur à discuter pour le moment. Laissez-moi.~
@13653 = ~Encore vous ?! On peut dire que vous forcez le destin en venant une fois de plus dans MA maison ! Je ne supporterai pas votre présence une minute de plus ! Dehors !~
@13654 = ~Sortez, ou je vous fais jeter dehors !~
@13655 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13656 = ~Vous avez abusé de notre hospitalité !~
@13657 = ~Vous avez abusé de notre hospitalité !~
@13658 = ~Vous avez mal agi ! Partez !~
@13659 = ~Re-bonjour. Je suppose que vous appréciez Bérégost dans toute sa piètre splendeur ?~
@13660 = ~Vous n'avez rien à faire chez moi. C'est une phrase que je n'ai pas l'habitude de prononcer, mais elle n'en est pas moins appropriée. Veuillez quitter les lieux.~
@13661 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13662 = ~Ne me dérangez pas, je dois préparer mes bagages.~
@13663 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13664 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13665 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13666 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13667 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13668 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13669 = ~Laissez-moi tranquille ! J'ai du travail !~
@13670 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13671 = ~Alors, j'dis au type, « mais si c'est vot' sœur, où est ma FEMME ? » Euh ! Oh, excusez-moi, je vous ai craché dessus ? Oh, revoilà mon ami ! Encore un petit verre pour trouver le courage de retourner dans cette saleté. Peut-être que je devrais rester encore un peu. Le ciel est dégagé mais ma tête est plutôt embrouillée.~
@13672 = ~Surprenant, ce coup de pied dans la tête, non ? Notre rabat-joie a rejoint le pays des fêtards. Je suppose que vous allez vous montrer un peu plus aimable maintenant ?~
@13673 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13674 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13675 = ~Laissez-moi, espèce d'ordure !~
@13676 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13677 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13678 = ~Je ne tolérerai pas votre présence après ce que vous avez fait !~
@13679 = ~Excusez-moi, mais je dois m'occuper de mes cultures.~
@13680 = ~Laissez-moi. Je n'ai rien pour vous.~
@13681 = ~Pardon si je vous offense, mais il faut que je parte, et vite.~
@13682 = ~Ne pensez-vous pas m'avoir déjà suffisamment importuné comme ça !~
@13683 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13684 = ~Quel plaisir de vous revoir ! Eh bien, je ferais mieux d'y aller, car j'ai des têtes à couper.~
