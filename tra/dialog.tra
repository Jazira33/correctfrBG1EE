@23874 = ~Avancez, avancez ! N'hésitez pas !~ [IKEEE_01]
@23875 = ~Je paierais le double pour en voir la fin maintenant !~ [IKEEE_02]
@23876 = ~Vous allez voir de quel bois j'me chauffe !~ [IKEEE_03]
@23877 = ~Un imbécile naît toutes les minutes, et vous êtes pile à l'heure.~ [IKEEE_04]
