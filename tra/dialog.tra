@14600 = ~Doucement Minsc, il n'est pas nécessaire d'être aussi maternel.~ [DYNAH28]
@14601 = ~Ne vous approchez pas ! Dynahéir est sous ma protection !~ [MINSC30]
@14602 = ~Maître du monde, hein ? Hummhumhum. Seulement si l'on vous choisit pour votre... esprit limpide.~ [QUAYL27]
@14603 = ~Maître du monde, hein ? Hummhumhum. Seulement si l'on vous choisit pour votre... esprit limpide.~ [QUAYL27]
