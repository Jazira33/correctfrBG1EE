@23879 = ~~ [IKEEE_06]
@23880 = ~Vous êtes pas des nôtres. Pas certain que vous puissiez le devenir.~ [VILLM01]
@23881 = ~~ [VILLM02]
@23882 = ~Vous ne vivrez pas *grogne* pour nous tuer ! Grrrr !~ [VILLM03]
