@23937 = ~Oui ? Z'avez quelque chose à dire ?~ [TSCFT03]
@23938 = ~Un peu d'excitation par ici, depuis quelque temps...~ [TSCFT04]
@23939 = ~Toujours d'accord pour parler à de nouveaux amis.~ [TSCFT05]
