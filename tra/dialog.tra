@13712 = ~Oiseau~
@13713 = ~Vautour~
@13714 = ~Mouette~
@13715 = ~Écureuil~
@13716 = ~Rat~
@13717 = ~Poule~
@13718 = ~Oiseau~
@13719 = ~Vautour~
@13720 = ~Mouette~
@13721 = ~Écureuil~
@13722 = ~Rat~
@13723 = ~Poule~
@13724 = ~CHOISIR QUANTITÉ~
@13725 = ~Furret~
@13726 = ~COMMANDES~
